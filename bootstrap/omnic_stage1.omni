        if self.peek_kind() == 1 && str_eq_raw(self.peek_text(), "as") == 1 {
            self.advance()
            while self.peek_kind() == 46 {
                self.advance()
            }
            if self.peek_kind() == 1 {
                self.advance()
            }
        }
        return cur
