        __omni_bytes_push_str(shstrtab, ".shstrtab")
        __omni_bytes_push_u8(shstrtab, 0)
        let sh_sym_nm = __omni_bytes_len(shstrtab)
        __omni_bytes_push_str(shstrtab, ".symtab")
        __omni_bytes_push_u8(shstrtab, 0)
        let sh_str_nm = __omni_bytes_len(shstrtab)
        __omni_bytes_push_str(shstrtab, ".strtab")
        __omni_bytes_push_u8(shstrtab, 0)

        let strtab = __omni_bytes_create(2048)
        __omni_bytes_push_u8(strtab, 0)
        let symtab = __omni_bytes_create(2048)
        elf64_push_sym(symtab, 0, 0, 0, 0, 0)
        elf64_push_sym(symtab, 0, 3, 2, 0, 0)

        let sfi = 0
        while sfi < nf {
            let nm_off = __omni_bytes_len(strtab)
            if has_main_wrapper == 1 && sfi == user_main_fidx {
                __omni_bytes_push_str(strtab, "__omni_user_main")
            } else {
                __omni_bytes_push_str(strtab, __omni_slice_get(self.fn_names, sfi))
            }
            __omni_bytes_push_u8(strtab, 0)
            elf64_push_sym(symtab, nm_off, 18, 1, __omni_slice_get(fn_text_offs, sfi), __omni_slice_get(fn_text_sizes, sfi))
            sfi = sfi + 1
        }
        if has_main_wrapper == 1 {
            let wm_off = __omni_bytes_len(strtab)
            __omni_bytes_push_str(strtab, "main")
            __omni_bytes_push_u8(strtab, 0)
            elf64_push_sym(symtab, wm_off, 18, 1, wrap_off, wrap_sz)
        }
        let ne = __omni_slice_len(self.extern_names)
        let sei = 0
        while sei < ne {
            let en_off = __omni_bytes_len(strtab)
            __omni_bytes_push_str(strtab, __omni_slice_get(self.extern_names, sei))
            __omni_bytes_push_u8(strtab, 0)
            elf64_push_sym(symtab, en_off, 16, 0, 0, 0)
            sei = sei + 1
        }

        let out = __omni_bytes_create(32768)
        __omni_bytes_push_u8(out, 127)
        __omni_bytes_push_str(out, "ELF")
        __omni_bytes_push_u8(out, 2)
        __omni_bytes_push_u8(out, 1)
        __omni_bytes_push_u8(out, 1)
        __omni_bytes_push_u8(out, 0)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u16(out, 1)
        __omni_bytes_push_u16(out, 62)
        __omni_bytes_push_u32(out, 1)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u64(out, 0)
        let shoff_patch = __omni_bytes_len(out)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u16(out, 64)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u16(out, 64)
        __omni_bytes_push_u16(out, 7)
        __omni_bytes_push_u16(out, 4)

        buf_pad_align(out, 16)
        let off_text = __omni_bytes_len(out)
        let sz_text = __omni_bytes_len(text)
        buf_append_buf(out, text)

        buf_pad_align(out, 8)
        let off_rodata = __omni_bytes_len(out)
        let sz_rodata = __omni_bytes_len(rodata)
        buf_append_buf(out, rodata)

        buf_pad_align(out, 8)
        let off_rela = __omni_bytes_len(out)
        let sz_rela = __omni_bytes_len(rela)
        buf_append_buf(out, rela)

        let off_shstr = __omni_bytes_len(out)
        let sz_shstr = __omni_bytes_len(shstrtab)
        buf_append_buf(out, shstrtab)

        buf_pad_align(out, 8)
        let off_sym = __omni_bytes_len(out)
        let sz_sym = __omni_bytes_len(symtab)
        buf_append_buf(out, symtab)

        let off_str = __omni_bytes_len(out)
        let sz_str = __omni_bytes_len(strtab)
        buf_append_buf(out, strtab)

        buf_pad_align(out, 8)
        let shoff = __omni_bytes_len(out)
        __omni_bytes_patch_u32(out, shoff_patch, shoff)

        elf64_push_shdr_a(out, 0, 0, 0, 0, 0)
        elf64_push_shdr_b(out, 0, 0, 0, 0)

        elf64_push_shdr_a(out, sh_text_nm, 1, 6, off_text, sz_text)
        elf64_push_shdr_b(out, 0, 0, 16, 0)

        elf64_push_shdr_a(out, sh_rodata_nm, 1, 2, off_rodata, sz_rodata)
        elf64_push_shdr_b(out, 0, 0, 8, 0)

        elf64_push_shdr_a(out, sh_rela_nm, 4, 64, off_rela, sz_rela)
        elf64_push_shdr_b(out, 5, 1, 8, 24)

        elf64_push_shdr_a(out, sh_shstr_nm, 3, 0, off_shstr, sz_shstr)
        elf64_push_shdr_b(out, 0, 0, 1, 0)

        elf64_push_shdr_a(out, sh_sym_nm, 2, 0, off_sym, sz_sym)
        elf64_push_shdr_b(out, 6, 2, 8, 24)

        elf64_push_shdr_a(out, sh_str_nm, 3, 0, off_str, sz_str)
        elf64_push_shdr_b(out, 0, 0, 1, 0)

        __omni_bytes_destroy(text)
        __omni_bytes_destroy(rodata)
        __omni_bytes_destroy(rela)
        __omni_bytes_destroy(shstrtab)
        __omni_bytes_destroy(symtab)
        __omni_bytes_destroy(strtab)
        return out
    }
}

fn compile_file(in_path: str, out_path: str) -> int {
    let source = __omni_fs_read_text(in_path)
    if __omni_str_len(source) == 0 {
        print("omnic_stage1: failed to read input file")
        return 1
    }
    let c = Compiler()
    c.init_compiler(source)
    c.compile_module()
    let olen = __omni_str_len(out_path)
    let is_obj = 0
    if olen >= 2 && __omni_str_byte_at(out_path, olen - 2) == 46 && __omni_str_byte_at(out_path, olen - 1) == 111 {
        is_obj = 1
    }
    let out_buf = 0
    if is_obj == 1 {
        out_buf = c.emit_elf64_x86_64()
    } else {
        out_buf = c.emit_obc_bytes()
    }
    let wrote = __omni_fs_write_bytes(out_path, out_buf)
    __omni_bytes_destroy(out_buf)
    print(wrote)
    return 0
}

fn main(argv: int) -> int {
    if __omni_slice_len(argv) < 3 {
        print("Usage: omnic_stage1 <input.omni> <output.obc>")
        return 1
    }
    let in_p = __omni_slice_get(argv, 1)
    let out_p = __omni_slice_get(argv, 2)
    return compile_file(in_p, out_p)
}
