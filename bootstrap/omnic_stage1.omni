                if tag == 62 {
                    let cond = x64_read_u16(ops_buf, cur)
                    let t_tgt = x64_read_u32(ops_buf, cur + 2)
                    let f_tgt = x64_read_u32(ops_buf, cur + 6)
                    cur = cur + 10
                    x64_load_rax(text, cond)
                    __omni_bytes_push_u8(text, 72)
                    __omni_bytes_push_u8(text, 133)
                    __omni_bytes_push_u8(text, 192)
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, 133)
                    let poff_t = __omni_bytes_len(text)
                    __omni_bytes_push_u32(text, 0)
                    __omni_slice_append(bp_offs, poff_t)
                    __omni_slice_append(bp_tgts, t_tgt)
                    __omni_bytes_push_u8(text, 233)
                    let poff_f = __omni_bytes_len(text)
                    __omni_bytes_push_u32(text, 0)
                    __omni_slice_append(bp_offs, poff_f)
                    __omni_slice_append(bp_tgts, f_tgt)
                }
                if tag == 64 {
                    let has_v = __omni_bytes_get(ops_buf, cur)
                    cur = cur + 1
                    if has_v == 1 {
                        let r = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                        x64_load_rax(text, r)
                    }
                    __omni_bytes_push_u8(text, 201)
                    __omni_bytes_push_u8(text, 195)
                }
                if tag == 66 {
                    let has_dst = __omni_bytes_get(ops_buf, cur)
                    cur = cur + 1
                    let dst = 0
                    if has_dst == 1 {
                        dst = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                    }
                    let cfidx = x64_read_u32(ops_buf, cur)
                    let na = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 6
                    let ai = 0
                    while ai < na {
                        let areg = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                        x64_load_arg_reg(text, ai, areg)
                        ai = ai + 1
                    }
                    __omni_bytes_push_u8(text, 232)
                    __omni_slice_append(fn_patches_off, __omni_bytes_len(text))
                    __omni_slice_append(fn_patches_fidx, cfidx)
                    __omni_bytes_push_u32(text, 0)
                    if has_dst == 1 {
                        x64_store_rax(text, dst)
                    }
                }
                if tag == 67 {
                    let has_dst = __omni_bytes_get(ops_buf, cur)
                    cur = cur + 1
                    let dst = 0
                    if has_dst == 1 {
                        dst = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                    }
                    let eidx = x64_read_u32(ops_buf, cur)
                    cur = cur + 5
                    let na = x64_read_u16(ops_buf, cur)
                    cur = cur + 2
                    let ai = 0
                    while ai < na {
                        let areg = x64_read_u16(ops_buf, cur)
                        cur = cur + 3
                        x64_load_arg_reg(text, ai, areg)
                        ai = ai + 1
                    }
                    if eidx > 1 {
                        print("omnic_stage1 error: unsupported extern in standalone binary")
                        __omni_bytes_destroy(text)
                        return 0
                    }
                    let tgt_off = pint_off
                    if eidx == 1 {
                        tgt_off = pstr_off
                    }
                    __omni_bytes_push_u8(text, 232)
                    let coff = __omni_bytes_len(text)
                    __omni_bytes_push_u32(text, tgt_off - (coff + 4))
                    if has_dst == 1 {
                        x64_store_rax(text, dst)
                    }
                }
                oi = oi + 1
            }

            let nbp = __omni_slice_len(bp_offs)
            let bpi = 0
            while bpi < nbp {
                let poff = __omni_slice_get(bp_offs, bpi)
                let tgt = __omni_slice_get(bp_tgts, bpi)
                let toff = __omni_slice_get(pc_to_off, tgt)
                __omni_bytes_patch_u32(text, poff, toff - (poff + 4))
                bpi = bpi + 1
            }

            __omni_bytes_destroy(ops_buf)
            fi = fi + 1
        }

        let rodata_off_in_text = __omni_bytes_len(text)
        let nfp = __omni_slice_len(fn_patches_off)
        let fpi = 0
        while fpi < nfp {
            let poff = __omni_slice_get(fn_patches_off, fpi)
            let tfidx = __omni_slice_get(fn_patches_fidx, fpi)
            let toff = __omni_slice_get(fn_text_offs, tfidx)
            __omni_bytes_patch_u32(text, poff, toff - (poff + 4))
            fpi = fpi + 1
        }
        let nrp = __omni_slice_len(rdata_patches_off)
        let rpi = 0
        while rpi < nrp {
            let poff = __omni_slice_get(rdata_patches_off, rpi)
            let goff = __omni_slice_get(rdata_patches_goff, rpi)
            __omni_bytes_patch_u32(text, poff, (rodata_off_in_text + goff) - (poff + 4))
            rpi = rpi + 1
        }

        let total_sz = 120 + __omni_bytes_len(text) + __omni_bytes_len(rodata)
        let out = __omni_bytes_create(total_sz + 16)
        // ELF64 ET_EXEC Header (64 bytes)
        __omni_bytes_push_u8(out, 127)
        __omni_bytes_push_str(out, "ELF")
        __omni_bytes_push_u8(out, 2)
        __omni_bytes_push_u8(out, 1)
        __omni_bytes_push_u8(out, 1)
        __omni_bytes_push_u8(out, 0)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u16(out, 2)
        __omni_bytes_push_u16(out, 62)
        __omni_bytes_push_u32(out, 1)
        __omni_bytes_push_u64(out, 0x400078)
        __omni_bytes_push_u64(out, 64)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u16(out, 64)
        __omni_bytes_push_u16(out, 56)
        __omni_bytes_push_u16(out, 1)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u16(out, 0)
        // PT_LOAD Program Header (56 bytes)
        __omni_bytes_push_u32(out, 1)
        __omni_bytes_push_u32(out, 7)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u64(out, 0x400000)
        __omni_bytes_push_u64(out, 0x400000)
        __omni_bytes_push_u64(out, total_sz)
        __omni_bytes_push_u64(out, total_sz)
        __omni_bytes_push_u64(out, 0x1000)

        buf_append_buf(out, text)
        buf_append_buf(out, rodata)
        __omni_bytes_destroy(text)
        __omni_bytes_destroy(rodata)
        return out
    }

    fn emit_macho_arm64(self) -> int {
        let nf = __omni_slice_len(self.fn_names)
        let ne = __omni_slice_len(self.extern_names)
        let cstr = __omni_bytes_create(1024)
        let global_offs = __omni_slice_create(64)
        let ng = __omni_slice_len(self.globals)
        let gi = 0
        while gi < ng {
            __omni_slice_append(global_offs, __omni_bytes_len(cstr))
            __omni_bytes_push_str(cstr, __omni_slice_get(self.globals, gi))
            __omni_bytes_push_u8(cstr, 0)
            gi = gi + 1
        }
        if __omni_bytes_len(cstr) == 0 {
            __omni_bytes_push_u8(cstr, 0)
        }

        let text = __omni_bytes_create(16384)
        let relocs = __omni_bytes_create(2048)
        let nrelocs = 0
        let fn_offs = __omni_slice_create(nf + 1)

        let fi = 0
        while fi < nf {
            __omni_slice_append(fn_offs, __omni_bytes_len(text))
            let nparams = __omni_slice_get(self.fn_params_count, fi)
            let nregs = __omni_slice_get(self.fn_regs_count, fi)
            let frame_sz = ((16 + nregs * 8 + 15) / 16) * 16
            if frame_sz < 32 {
                frame_sz = 32
            }
            a64_movz_imm16(text, 9, frame_sz & 0xFFFF)
            if frame_sz >= 65536 {
                a64_movk_imm16(text, 9, (frame_sz >> 16) & 0xFFFF, 1)
            }
            __omni_bytes_push_u32(text, 0xCB2963FF)
            __omni_bytes_push_u32(text, 0xA9007BFD)
            __omni_bytes_push_u32(text, 0x910003FD)
            let pi = 0
            while pi < nparams {
                a64_str_slot(text, pi, pi)
                pi = pi + 1
            }

            let ops_buf = __omni_slice_get(self.fn_ops_bufs, fi)
            let op_count = __omni_slice_get(self.fn_ops_counts, fi)
            let pc_to_off = __omni_slice_create(op_count + 1)
            let bp_offs = __omni_slice_create(32)
            let bp_tgts = __omni_slice_create(32)
            let bp_kinds = __omni_slice_create(32)
            let cur = 0
            let oi = 0
            while oi < op_count {
                __omni_slice_append(pc_to_off, __omni_bytes_len(text))
                let tag = __omni_bytes_get(ops_buf, cur)
                cur = cur + 1
                if tag == 1 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let w0 = x64_read_u16(ops_buf, cur + 2)
                    let w1 = x64_read_u16(ops_buf, cur + 4)
                    let w2 = x64_read_u16(ops_buf, cur + 6)
                    let w3 = x64_read_u16(ops_buf, cur + 8)
                    cur = cur + 10
                    a64_movz_imm16(text, 0, w0)
                    if w1 != 0 {
                        a64_movk_imm16(text, 0, w1, 1)
                    }
                    if w2 != 0 {
                        a64_movk_imm16(text, 0, w2, 2)
                    }
                    if w3 != 0 {
                        a64_movk_imm16(text, 0, w3, 3)
                    }
                    a64_str_slot(text, 0, dst)
                }
                if tag == 2 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let gidx = x64_read_u32(ops_buf, cur + 2)
                    cur = cur + 6
                    // Mach-O ARM64_RELOC_PAGE21 (3) + PAGEOFF12 (4) with r_extern=1 -> local string sym (nf + ne + gidx)
                    let str_sym = nf + ne + gidx
                    let adrp_off = __omni_bytes_len(text)
                    __omni_bytes_push_u32(text, 0x90000000)
                    __omni_bytes_push_u32(relocs, adrp_off)
                    __omni_bytes_push_u32(relocs, str_sym | (1 << 24) | (2 << 25) | (1 << 27) | (3 << 28))
                    let add_off = __omni_bytes_len(text)
                    __omni_bytes_push_u32(text, 0x91000000)
                    __omni_bytes_push_u32(relocs, add_off)
                    __omni_bytes_push_u32(relocs, str_sym | (0 << 24) | (2 << 25) | (1 << 27) | (4 << 28))
                    nrelocs = nrelocs + 2
                    a64_str_slot(text, 0, dst)
                }
                if tag == 4 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let src = x64_read_u16(ops_buf, cur + 2)
                    cur = cur + 4
                    a64_ldr_slot(text, 0, src)
                    a64_str_slot(text, 0, dst)
                }
                if tag == 12 || tag == 13 || tag == 14 || tag == 15 || tag == 17 || (tag >= 19 && tag <= 24) {
                    let dst = x64_read_u16(ops_buf, cur)
                    let a = x64_read_u16(ops_buf, cur + 2)
                    let b = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 6
                    a64_ldr_slot(text, 0, a)
                    a64_ldr_slot(text, 1, b)
                    if tag == 12 {
                        __omni_bytes_push_u32(text, 0x8B010000)
                    }
                    if tag == 13 {
                        __omni_bytes_push_u32(text, 0xCB010000)
                    }
                    if tag == 14 {
                        __omni_bytes_push_u32(text, 0x9B017C00)
                    }
                    if tag == 15 {
                        __omni_bytes_push_u32(text, 0x9AC10C00)
                    }
                    if tag == 17 {
                        __omni_bytes_push_u32(text, 0x9AC10C02)
                        __omni_bytes_push_u32(text, 0x9B018040)
                    }
                    if tag == 19 {
                        __omni_bytes_push_u32(text, 0x8A010000)
                    }
                    if tag == 20 {
                        __omni_bytes_push_u32(text, 0xAA010000)
                    }
                    if tag == 21 {
                        __omni_bytes_push_u32(text, 0xCA010000)
                    }
                    if tag == 22 {
                        __omni_bytes_push_u32(text, 0x9AC12000)
                    }
                    if tag == 23 {
                        __omni_bytes_push_u32(text, 0x9AC12800)
                    }
                    if tag == 24 {
                        __omni_bytes_push_u32(text, 0x9AC12400)
                    }
                    a64_str_slot(text, 0, dst)
                }
                if tag >= 29 && tag <= 32 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let a = x64_read_u16(ops_buf, cur + 2)
                    let b = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 6
                    __omni_bytes_push_u32(text, 0xFD4003A0 | ((2 + a) << 10) | 0)
                    __omni_bytes_push_u32(text, 0xFD4003A0 | ((2 + b) << 10) | 1)
                    if tag == 29 {
                        __omni_bytes_push_u32(text, 0x1E612800)
                    }
                    if tag == 30 {
                        __omni_bytes_push_u32(text, 0x1E613800)
                    }
                    if tag == 31 {
                        __omni_bytes_push_u32(text, 0x1E610800)
                    }
                    if tag == 32 {
                        __omni_bytes_push_u32(text, 0x1E611800)
                    }
                    __omni_bytes_push_u32(text, 0xFD0003A0 | ((2 + dst) << 10) | 0)
                }
                if tag == 27 || tag == 39 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let cc = __omni_bytes_get(ops_buf, cur + 2)
                    let a = x64_read_u16(ops_buf, cur + 3)
                    let b = x64_read_u16(ops_buf, cur + 5)
                    cur = cur + 7
                    if tag == 39 {
                        __omni_bytes_push_u32(text, 0xFD4003A0 | ((2 + a) << 10) | 0)
                        __omni_bytes_push_u32(text, 0xFD4003A0 | ((2 + b) << 10) | 1)
                        __omni_bytes_push_u32(text, 0x1E612000)
                        let fcset = 0x9A9F17E0
                        if cc == 1 {
                            fcset = 0x9A9F07E0
                        }
                        if cc == 2 {
                            fcset = 0x9A9F57E0
                        }
                        if cc == 3 {
                            fcset = 0x9A9F87E0
                        }
                        if cc == 4 {
                            fcset = 0x9A9FD7E0
                        }
                        if cc == 5 {
                            fcset = 0x9A9FB7E0
                        }
                        __omni_bytes_push_u32(text, fcset)
                    } else {
                        a64_ldr_slot(text, 0, a)
                        a64_ldr_slot(text, 1, b)
                        __omni_bytes_push_u32(text, 0xEB01001F)
                        let cset_w = 0x9A9F17E0
                        if cc == 1 {
                            cset_w = 0x9A9F07E0
                        }
                        if cc == 2 {
                            cset_w = 0x9A9FA7E0
                        }
                        if cc == 3 {
                            cset_w = 0x9A9FC7E0
                        }
                        if cc == 4 {
                            cset_w = 0x9A9FD7E0
                        }
                        if cc == 5 {
                            cset_w = 0x9A9FB7E0
                        }
                        __omni_bytes_push_u32(text, cset_w)
                    }
                    a64_str_slot(text, 0, dst)
                }
                if tag == 61 {
                    let tgt = x64_read_u32(ops_buf, cur)
                    cur = cur + 4
                    __omni_slice_append(bp_offs, __omni_bytes_len(text))
                    __omni_slice_append(bp_tgts, tgt)
                    __omni_slice_append(bp_kinds, 0)
                    __omni_bytes_push_u32(text, 0x14000000)
                }
                if tag == 62 {
                    let cond = x64_read_u16(ops_buf, cur)
                    let t_tgt = x64_read_u32(ops_buf, cur + 2)
                    let f_tgt = x64_read_u32(ops_buf, cur + 6)
                    cur = cur + 10
                    a64_ldr_slot(text, 0, cond)
                    __omni_slice_append(bp_offs, __omni_bytes_len(text))
                    __omni_slice_append(bp_tgts, t_tgt)
                    __omni_slice_append(bp_kinds, 1)
                    __omni_bytes_push_u32(text, 0xB5000000)
                    __omni_slice_append(bp_offs, __omni_bytes_len(text))
                    __omni_slice_append(bp_tgts, f_tgt)
                    __omni_slice_append(bp_kinds, 0)
                    __omni_bytes_push_u32(text, 0x14000000)
                }
                if tag == 64 {
                    let has_v = __omni_bytes_get(ops_buf, cur)
                    cur = cur + 1
                    if has_v == 1 {
                        let r = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                        a64_ldr_slot(text, 0, r)
                    }
                    __omni_bytes_push_u32(text, 0x910003BF)
                    __omni_bytes_push_u32(text, 0xA9407BFD)
                    a64_movz_imm16(text, 9, frame_sz & 0xFFFF)
                    if frame_sz >= 65536 {
                        a64_movk_imm16(text, 9, (frame_sz >> 16) & 0xFFFF, 1)
                    }
                    __omni_bytes_push_u32(text, 0x8B2963FF)
                    __omni_bytes_push_u32(text, 0xD65F03C0)
                }
                if tag == 66 {
                    let has_dst = __omni_bytes_get(ops_buf, cur)
                    cur = cur + 1
                    let dst = 0
                    if has_dst == 1 {
                        dst = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                    }
                    let cfidx = x64_read_u32(ops_buf, cur)
                    let na = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 6
                    let ai = 0
                    while ai < na {
                        a64_ldr_slot(text, ai, x64_read_u16(ops_buf, cur))
                        cur = cur + 2
                        ai = ai + 1
                    }
                    let coff = __omni_bytes_len(text)
                    __omni_bytes_push_u32(text, 0x94000000)
                    // ARM64_RELOC_BRANCH26 (2), extern=1, length=2 (4 bytes), pcrel=1
                    __omni_bytes_push_u32(relocs, coff)
                    __omni_bytes_push_u32(relocs, cfidx | (1 << 24) | (2 << 25) | (1 << 27) | (2 << 28))
                    nrelocs = nrelocs + 1
                    if has_dst == 1 {
                        a64_str_slot(text, 0, dst)
                    }
                }
                if tag == 67 {
                    let has_dst = __omni_bytes_get(ops_buf, cur)
                    cur = cur + 1
                    let dst = 0
                    if has_dst == 1 {
                        dst = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                    }
                    let eidx = x64_read_u32(ops_buf, cur)
                    cur = cur + 5
                    let na = x64_read_u16(ops_buf, cur)
                    cur = cur + 2
                    let ai = 0
                    while ai < na {
                        a64_ldr_slot(text, ai, x64_read_u16(ops_buf, cur))
                        cur = cur + 3
                        ai = ai + 1
                    }
                    let coff = __omni_bytes_len(text)
                    __omni_bytes_push_u32(text, 0x94000000)
                    __omni_bytes_push_u32(relocs, coff)
                    __omni_bytes_push_u32(relocs, (nf + eidx) | (1 << 24) | (2 << 25) | (1 << 27) | (2 << 28))
                    nrelocs = nrelocs + 1
                    if has_dst == 1 {
                        a64_str_slot(text, 0, dst)
                    }
                }
                oi = oi + 1
            }
            let nbp = __omni_slice_len(bp_offs)
            let bpi = 0
            while bpi < nbp {
                let poff = __omni_slice_get(bp_offs, bpi)
                let tgt = __omni_slice_get(bp_tgts, bpi)
                let bkind = __omni_slice_get(bp_kinds, bpi)
                let toff = __omni_slice_get(pc_to_off, tgt)
                let rel_w = (toff - poff) / 4
                if bkind == 0 {
                    __omni_bytes_patch_u32(text, poff, 0x14000000 | (rel_w & 0x03FFFFFF))
                } else {
                    __omni_bytes_patch_u32(text, poff, 0xB5000000 | ((rel_w & 0x7FFFF) << 5))
                }
                bpi = bpi + 1
            }
            __omni_bytes_destroy(ops_buf)
            fi = fi + 1
        }

        let strtab = __omni_bytes_create(1024)
        __omni_bytes_push_u8(strtab, 0)
        let symtab = __omni_bytes_create(1024)
        let sfi = 0
        while sfi < nf {
            let noff = __omni_bytes_len(strtab)
            __omni_bytes_push_str(strtab, "_")
            __omni_bytes_push_str(strtab, __omni_slice_get(self.fn_names, sfi))
            __omni_bytes_push_u8(strtab, 0)
            __omni_bytes_push_u32(symtab, noff)
            __omni_bytes_push_u8(symtab, 15)
            __omni_bytes_push_u8(symtab, 1)
            __omni_bytes_push_u16(symtab, 0)
            __omni_bytes_push_u64(symtab, __omni_slice_get(fn_offs, sfi))
            sfi = sfi + 1
        }
        let sei = 0
        while sei < ne {
            let noff = __omni_bytes_len(strtab)
            __omni_bytes_push_str(strtab, "_")
            __omni_bytes_push_str(strtab, __omni_slice_get(self.extern_names, sei))
            __omni_bytes_push_u8(strtab, 0)
            __omni_bytes_push_u32(symtab, noff)
            __omni_bytes_push_u8(symtab, 1)
            __omni_bytes_push_u8(symtab, 0)
            __omni_bytes_push_u16(symtab, 0)
            __omni_bytes_push_u64(symtab, 0)
            sei = sei + 1
        }
        buf_pad_align(text, 8)
        let text_sz = __omni_bytes_len(text)
        let sgi = 0
        while sgi < ng {
            let noff = __omni_bytes_len(strtab)
            __omni_bytes_push_str(strtab, "L_str")
            __omni_bytes_push_u8(strtab, 0)
            __omni_bytes_push_u32(symtab, noff)
            __omni_bytes_push_u8(symtab, 14)
            __omni_bytes_push_u8(symtab, 2)
            __omni_bytes_push_u16(symtab, 0)
            __omni_bytes_push_u64(symtab, text_sz + __omni_slice_get(global_offs, sgi))
            sgi = sgi + 1
        }
        buf_pad_align(cstr, 8)
        buf_pad_align(relocs, 8)
        let cstr_sz = __omni_bytes_len(cstr)
        let seg_cmd_sz = 72 + 160
        let text_off = 32 + seg_cmd_sz + 24
        let cstr_off = text_off + text_sz
        let reloc_off = cstr_off + cstr_sz
        let sym_off = reloc_off + __omni_bytes_len(relocs)
        let str_off = sym_off + __omni_bytes_len(symtab)
        let str_sz = __omni_bytes_len(strtab)

        let out = __omni_bytes_create(8192)
        // mach_header_64 (32 bytes)
        __omni_bytes_push_u32(out, 0xFEEDFACF)
        __omni_bytes_push_u32(out, 0x0100000C)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 1)
        __omni_bytes_push_u32(out, 2)
        __omni_bytes_push_u32(out, seg_cmd_sz + 24)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        // LC_SEGMENT_64 (72 bytes + 2 * 80 bytes sections = 232 bytes)
        __omni_bytes_push_u32(out, 0x19)
        __omni_bytes_push_u32(out, seg_cmd_sz)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u64(out, text_sz + cstr_sz)
        __omni_bytes_push_u64(out, text_off)
        __omni_bytes_push_u64(out, text_sz + cstr_sz)
        __omni_bytes_push_u32(out, 7)
        __omni_bytes_push_u32(out, 5)
        __omni_bytes_push_u32(out, 2)
        __omni_bytes_push_u32(out, 0)
        // Section 1: __text / __TEXT
        __omni_bytes_push_str(out, "__text")
        let p1 = 0
        while p1 < 10 {
            __omni_bytes_push_u8(out, 0)
            p1 = p1 + 1
        }
        __omni_bytes_push_str(out, "__TEXT")
        let p2 = 0
        while p2 < 10 {
            __omni_bytes_push_u8(out, 0)
            p2 = p2 + 1
        }
        __omni_bytes_push_u64(out, 0)
        __omni_bytes_push_u64(out, text_sz)
        __omni_bytes_push_u32(out, text_off)
        __omni_bytes_push_u32(out, 2)
        __omni_bytes_push_u32(out, reloc_off)
        __omni_bytes_push_u32(out, nrelocs)
        __omni_bytes_push_u32(out, 0x80000400)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        // Section 2: __cstring / __TEXT
        __omni_bytes_push_str(out, "__cstring")
        let p3 = 0
        while p3 < 7 {
            __omni_bytes_push_u8(out, 0)
            p3 = p3 + 1
        }
        __omni_bytes_push_str(out, "__TEXT")
        let p4 = 0
        while p4 < 10 {
            __omni_bytes_push_u8(out, 0)
            p4 = p4 + 1
        }
        __omni_bytes_push_u64(out, text_sz)
        __omni_bytes_push_u64(out, cstr_sz)
        __omni_bytes_push_u32(out, cstr_off)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 2)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        // LC_SYMTAB (24 bytes)
        __omni_bytes_push_u32(out, 2)
        __omni_bytes_push_u32(out, 24)
        __omni_bytes_push_u32(out, sym_off)
        __omni_bytes_push_u32(out, nf + ne + ng)
        __omni_bytes_push_u32(out, str_off)
        __omni_bytes_push_u32(out, str_sz)

        buf_append_buf(out, text)
        buf_append_buf(out, cstr)
        buf_append_buf(out, relocs)
        buf_append_buf(out, symtab)
        buf_append_buf(out, strtab)
        __omni_bytes_destroy(text)
        __omni_bytes_destroy(cstr)
        __omni_bytes_destroy(relocs)
        __omni_bytes_destroy(symtab)
        __omni_bytes_destroy(strtab)
        return out
    }
}

fn compile_file(in_path: str, out_path: str, target_fmt: str) -> int {
    let visited = __omni_slice_create(16)
    let source = load_source_with_imports(in_path, visited)
    if __omni_str_len(source) == 0 {
        print("omnic_stage1: failed to read input file")
        return 1
    }
    let c = Compiler()
    c.init_compiler(source)
    c.compile_module()
    let olen = __omni_str_len(out_path)
    let is_uf2 = 0
    let is_elf_exec = 0
    let is_exe = 0
    let is_macho = 0
    let is_arm64 = 0
    let is_obj = 0
    let is_obc = 0
    if __omni_str_len(target_fmt) > 0 {
        if __omni_str_eq(target_fmt, "obc") == 1 {
            is_obc = 1
        }
        if __omni_str_eq(target_fmt, "rp2350-uf2") == 1 {
            is_uf2 = 1
        }
        if __omni_str_eq(target_fmt, "x86_64-linux-exec") == 1 {
            is_elf_exec = 1
        }
        if __omni_str_eq(target_fmt, "x86_64-windows-pe") == 1 {
            is_exe = 1
        }
        if __omni_str_eq(target_fmt, "aarch64-macos-macho") == 1 {
            is_macho = 1
        }
        if __omni_str_eq(target_fmt, "aarch64-elf-obj") == 1 {
            is_arm64 = 1
        }
        if __omni_str_eq(target_fmt, "x86_64-elf-obj") == 1 {
            is_obj = 1
        }
        if is_obc == 0 && is_uf2 == 0 && is_elf_exec == 0 && is_exe == 0 && is_macho == 0 && is_arm64 == 0 && is_obj == 0 {
            print("omnic_stage1 error: unknown --target format")
            return 1
        }
    } else {
        if olen >= 4 && __omni_str_eq(__omni_str_slice_step(out_path, olen - 4, olen, 1, 1, 1), ".uf2") == 1 {
            is_uf2 = 1
        }
        if is_uf2 == 0 && olen >= 4 && __omni_str_eq(__omni_str_slice_step(out_path, olen - 4, olen, 1, 1, 1), ".elf") == 1 {
            is_elf_exec = 1
        }
        if is_uf2 == 0 && is_elf_exec == 0 && olen >= 4 && __omni_str_eq(__omni_str_slice_step(out_path, olen - 4, olen, 1, 1, 1), ".exe") == 1 {
            is_exe = 1
        }
        if is_uf2 == 0 && is_elf_exec == 0 && is_exe == 0 && olen >= 8 && __omni_str_eq(__omni_str_slice_step(out_path, olen - 8, olen, 1, 1, 1), ".macho.o") == 1 {
            is_macho = 1
        }
        if is_uf2 == 0 && is_elf_exec == 0 && is_exe == 0 && is_macho == 0 && olen >= 8 && __omni_str_eq(__omni_str_slice_step(out_path, olen - 8, olen, 1, 1, 1), ".arm64.o") == 1 {
            is_arm64 = 1
        }
        if is_uf2 == 0 && is_elf_exec == 0 && is_exe == 0 && is_macho == 0 && is_arm64 == 0 && olen >= 2 && __omni_str_byte_at(out_path, olen - 2) == 46 && __omni_str_byte_at(out_path, olen - 1) == 111 {
            is_obj = 1
        }
    }
    let out_buf = 0
    if is_uf2 == 1 {
        out_buf = c.emit_uf2_rp2350()
    }
    if is_elf_exec == 1 {
        out_buf = c.emit_elf64_exec_x86_64()
    }
    if is_exe == 1 {
        out_buf = c.emit_pe64_x86_64()
    }
    if is_macho == 1 {
        out_buf = c.emit_macho_arm64()
    }
    if is_arm64 == 1 {
        out_buf = c.emit_elf64_aarch64()
    }
    if is_obj == 1 {
        out_buf = c.emit_elf64_x86_64()
    }
    if is_uf2 == 0 && is_elf_exec == 0 && is_exe == 0 && is_macho == 0 && is_arm64 == 0 && is_obj == 0 {
        out_buf = c.emit_obc_bytes()
    }
    if out_buf == 0 {
        return 1
    }
    let wrote = __omni_fs_write_bytes(out_path, out_buf)
    __omni_bytes_destroy(out_buf)
    print(wrote)
    return 0
}

fn main(argv: int) -> int {
    let argc = __omni_slice_len(argv)
    if argc < 3 {
        print("Usage: omnic_stage1 [--target <fmt>] <input> <output>")
        return 1
    }
    if argc >= 5 && __omni_str_eq(__omni_slice_get(argv, 1), "--target") == 1 {
        return compile_file(__omni_slice_get(argv, 3), __omni_slice_get(argv, 4), __omni_slice_get(argv, 2))
    }
    let in_p = __omni_slice_get(argv, 1)
    let out_p = __omni_slice_get(argv, 2)
    return compile_file(in_p, out_p, "")
}
