            }

            __omni_bytes_destroy(ops_buf)
            fi = fi + 1
        }

        let text_vsz = __omni_bytes_len(text)
        let text_rsz = ((text_vsz + 511) / 512) * 512
        let text_rva = 0x1000
        let rdata_rva = text_rva + ((text_vsz + 4095) / 4096) * 4096
        let rdata_vsz = __omni_bytes_len(rdata)
        let rdata_rsz = ((rdata_vsz + 511) / 512) * 512
        let idata_rva = rdata_rva + ((rdata_vsz + 4095) / 4096) * 4096

        let nfp = __omni_slice_len(fn_patches_off)
        let fpi = 0
        while fpi < nfp {
            let poff = __omni_slice_get(fn_patches_off, fpi)
            let tfidx = __omni_slice_get(fn_patches_fidx, fpi)
            let toff = __omni_slice_get(fn_text_offs, tfidx)
            __omni_bytes_patch_u32(text, poff, toff - (poff + 4))
            fpi = fpi + 1
        }
        let nrp = __omni_slice_len(rdata_patches_off)
        let rpi = 0
        while rpi < nrp {
            let poff = __omni_slice_get(rdata_patches_off, rpi)
            let goff = __omni_slice_get(rdata_patches_goff, rpi)
            let tgt_rva = rdata_rva + goff
            let rip_rva = text_rva + poff + 4
            __omni_bytes_patch_u32(text, poff, tgt_rva - rip_rva)
            rpi = rpi + 1
        }
        let nip = __omni_slice_len(iat_patches_off)
        let ipi = 0
        while ipi < nip {
            let poff = __omni_slice_get(iat_patches_off, ipi)
            let slot_i = __omni_slice_get(iat_patches_idx, ipi)
            let iat_rva = idata_rva + 0x48 + slot_i * 8
            let rip_rva = text_rva + poff + 4
            __omni_bytes_patch_u32(text, poff, iat_rva - rip_rva)
            ipi = ipi + 1
        }

        // Build .idata (KERNEL32.dll: ExitProcess, GetStdHandle, WriteFile)
        let idata = __omni_bytes_create(512)
        __omni_bytes_push_u32(idata, idata_rva + 0x28)
        __omni_bytes_push_u32(idata, 0)
        __omni_bytes_push_u32(idata, 0)
        __omni_bytes_push_u32(idata, idata_rva + 0x68)
        __omni_bytes_push_u32(idata, idata_rva + 0x48)
        __omni_bytes_push_u32(idata, 0)
        __omni_bytes_push_u32(idata, 0)
        __omni_bytes_push_u32(idata, 0)
        __omni_bytes_push_u32(idata, 0)
        __omni_bytes_push_u32(idata, 0)
        // ILT at +0x28
        __omni_bytes_push_u64(idata, idata_rva + 0x78)
        __omni_bytes_push_u64(idata, idata_rva + 0x88)
        __omni_bytes_push_u64(idata, idata_rva + 0x98)
        __omni_bytes_push_u64(idata, 0)
        // IAT at +0x48
        __omni_bytes_push_u64(idata, idata_rva + 0x78)
        __omni_bytes_push_u64(idata, idata_rva + 0x88)
        __omni_bytes_push_u64(idata, idata_rva + 0x98)
        __omni_bytes_push_u64(idata, 0)
        // DLL name at +0x68 (16 bytes)
        __omni_bytes_push_str(idata, "KERNEL32.dll")
        __omni_bytes_push_u32(idata, 0)
        // Hint/Name 0 at +0x78 (16 bytes)
        __omni_bytes_push_u16(idata, 0)
        __omni_bytes_push_str(idata, "ExitProcess")
        __omni_bytes_push_u8(idata, 0)
        __omni_bytes_push_u16(idata, 0)
        // Hint/Name 1 at +0x88 (16 bytes)
        __omni_bytes_push_u16(idata, 0)
        __omni_bytes_push_str(idata, "GetStdHandle")
        __omni_bytes_push_u16(idata, 0)
        // Hint/Name 2 at +0x98 (16 bytes)
        __omni_bytes_push_u16(idata, 0)
        __omni_bytes_push_str(idata, "WriteFile")
        __omni_bytes_push_u8(idata, 0)
        __omni_bytes_push_u32(idata, 0)

