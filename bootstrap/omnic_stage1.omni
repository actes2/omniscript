                    __omni_bytes_push_u8(text, 72)
                    __omni_bytes_push_u8(text, 141)
                    __omni_bytes_push_u8(text, 5)
                    __omni_slice_append(rdata_patches_off, __omni_bytes_len(text))
                    __omni_slice_append(rdata_patches_goff, __omni_slice_get(global_offs, gidx))
                    __omni_bytes_push_u32(text, 0)
                    x64_store_rax(text, dst)
                }
                if tag == 4 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let src = x64_read_u16(ops_buf, cur + 2)
                    cur = cur + 4
                    x64_load_rax(text, src)
                    x64_store_rax(text, dst)
                }
                if tag == 12 || tag == 13 || tag == 14 || tag == 15 || tag == 17 || (tag >= 19 && tag <= 24) {
                    let dst = x64_read_u16(ops_buf, cur)
                    let a = x64_read_u16(ops_buf, cur + 2)
                    let b = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 6
                    x64_load_rax(text, a)
                    x64_load_rcx(text, b)
                    if tag == 12 {
