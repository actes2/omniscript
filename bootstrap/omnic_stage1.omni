                    __omni_bytes_push_u32(text, x64_slot_disp(op_l))
                    __omni_bytes_push_u8(text, 102)
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, 46)
                    __omni_bytes_push_u8(text, 133)
                    __omni_bytes_push_u32(text, x64_slot_disp(op_r))
                    if cc == 0 {
