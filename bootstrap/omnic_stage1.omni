// ============================================================================
// OmniScript Stage-1 Self-Hosted Compiler (`bootstrap/omnic_stage1.omni`)
// 100% Deterministic OmniScript -> compiles `.omni` source directly to `OBC1`
// Capable of compiling ITSELF (Stage-1 -> Stage-2 -> Stage-3 fixpoint)!
// ============================================================================

extern fn __omni_bytes_create(cap: int) -> int;
extern fn __omni_bytes_push_u8(buf: int, v: int) -> void;
extern fn __omni_bytes_push_u16(buf: int, v: int) -> void;
extern fn __omni_bytes_push_u32(buf: int, v: int) -> void;
extern fn __omni_bytes_push_u64(buf: int, v: int) -> void;
extern fn __omni_bytes_push_str(buf: int, s: str) -> void;
extern fn __omni_bytes_patch_u32(buf: int, off: int, v: int) -> void;
extern fn __omni_bytes_get(buf: int, off: int) -> int;
extern fn __omni_bytes_len(buf: int) -> int;
extern fn __omni_bytes_destroy(buf: int) -> void;
extern fn __omni_fs_read_text(path: str) -> str;
extern fn __omni_fs_write_bytes(path: str, buf: int) -> int;
extern fn __omni_str_byte_at(s: str, idx: int) -> int;
extern fn __omni_str_slice_step(s: str, st: int, en: int, step: int, has_s: int, has_e: int) -> str;
extern fn __omni_str_len(s: str) -> int;
extern fn __omni_str_eq(a: str, b: str) -> int;
extern fn __omni_c_str_to_i64(s: str) -> int;
extern fn __omni_slice_create(cap: int) -> int;
extern fn __omni_slice_append(sl: int, val: int) -> void;
extern fn __omni_slice_get(sl: int, idx: int) -> int;
extern fn __omni_slice_set(sl: int, idx: int, val: int) -> void;
extern fn __omni_slice_len(sl: int) -> int;

fn is_alpha(c: int) -> int {
    if c >= 65 && c <= 90 {
        return 1
    }
    if c >= 97 && c <= 122 {
        return 1
    }
    if c == 95 {
        return 1
    }
    return 0
}

fn is_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return 1
    }
    return 0
}

fn is_alnum(c: int) -> int {
    if is_alpha(c) == 1 {
        return 1
    }
    if is_digit(c) == 1 {
        return 1
    }
    return 0
}

fn str_eq_raw(a: int, b: str) -> int {
    return __omni_str_eq(a, b)
}

fn x64_read_u16(buf: int, off: int) -> int {
    let b0 = __omni_bytes_get(buf, off)
    let b1 = __omni_bytes_get(buf, off + 1)
    return b0 + b1 * 256
}

fn x64_read_u32(buf: int, off: int) -> int {
    let b0 = __omni_bytes_get(buf, off)
    let b1 = __omni_bytes_get(buf, off + 1)
    let b2 = __omni_bytes_get(buf, off + 2)
    let b3 = __omni_bytes_get(buf, off + 3)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

fn x64_slot_disp(reg: int) -> int {
    return 0 - (reg + 1) * 8
}

fn x64_load_rax(text: int, reg: int) -> int {
    __omni_bytes_push_u8(text, 72)
    __omni_bytes_push_u8(text, 139)
    __omni_bytes_push_u8(text, 133)
    __omni_bytes_push_u32(text, x64_slot_disp(reg))
    return 0
}

fn x64_store_rax(text: int, reg: int) -> int {
    __omni_bytes_push_u8(text, 72)
    __omni_bytes_push_u8(text, 137)
    __omni_bytes_push_u8(text, 133)
    __omni_bytes_push_u32(text, x64_slot_disp(reg))
    return 0
}

fn x64_load_rcx(text: int, reg: int) -> int {
    __omni_bytes_push_u8(text, 72)
    __omni_bytes_push_u8(text, 139)
    __omni_bytes_push_u8(text, 141)
    __omni_bytes_push_u32(text, x64_slot_disp(reg))
    return 0
}

fn x64_store_rdx(text: int, reg: int) -> int {
    __omni_bytes_push_u8(text, 72)
    __omni_bytes_push_u8(text, 137)
    __omni_bytes_push_u8(text, 149)
    __omni_bytes_push_u32(text, x64_slot_disp(reg))
    return 0
}

fn x64_load_arg_reg(text: int, arg_idx: int, slot_reg: int) -> int {
    let rex = 72
    let modrm = 189
    if arg_idx == 0 {
        rex = 72
        modrm = 189
    }
    if arg_idx == 1 {
        rex = 72
        modrm = 181
    }
    if arg_idx == 2 {
        rex = 72
        modrm = 149
    }
    if arg_idx == 3 {
        rex = 72
        modrm = 141
    }
    if arg_idx == 4 {
        rex = 76
        modrm = 133
    }
    if arg_idx == 5 {
        rex = 76
        modrm = 141
    }
    __omni_bytes_push_u8(text, rex)
    __omni_bytes_push_u8(text, 139)
    __omni_bytes_push_u8(text, modrm)
    __omni_bytes_push_u32(text, x64_slot_disp(slot_reg))
    return 0
}

fn x64_store_arg_reg(text: int, arg_idx: int, slot_reg: int) -> int {
    let rex = 72
    let modrm = 189
    if arg_idx == 0 {
        rex = 72
        modrm = 189
    }
    if arg_idx == 1 {
        rex = 72
        modrm = 181
    }
    if arg_idx == 2 {
        rex = 72
        modrm = 149
    }
    if arg_idx == 3 {
        rex = 72
        modrm = 141
    }
    if arg_idx == 4 {
        rex = 76
        modrm = 133
    }
    if arg_idx == 5 {
        rex = 76
        modrm = 141
    }
    __omni_bytes_push_u8(text, rex)
    __omni_bytes_push_u8(text, 137)
    __omni_bytes_push_u8(text, modrm)
    __omni_bytes_push_u32(text, x64_slot_disp(slot_reg))
    return 0
}

fn x64_add_rela(rela: int, off: int, sym_idx: int, rtype: int, addend: int) -> int {
    __omni_bytes_push_u64(rela, off)
    __omni_bytes_push_u32(rela, rtype)
    __omni_bytes_push_u32(rela, sym_idx)
    __omni_bytes_push_u64(rela, addend)
    return 0
}

fn elf64_push_sym(symtab: int, name_off: int, info: int, shndx: int, val: int, size: int) -> int {
    __omni_bytes_push_u32(symtab, name_off)
    __omni_bytes_push_u8(symtab, info)
    __omni_bytes_push_u8(symtab, 0)
    __omni_bytes_push_u16(symtab, shndx)
    __omni_bytes_push_u64(symtab, val)
    __omni_bytes_push_u64(symtab, size)
    return 0
}

fn elf64_push_shdr_a(out: int, name_off: int, stype: int, sflags: int, soff: int, ssize: int) -> int {
    __omni_bytes_push_u32(out, name_off)
    __omni_bytes_push_u32(out, stype)
    __omni_bytes_push_u64(out, sflags)
    __omni_bytes_push_u64(out, 0)
    __omni_bytes_push_u64(out, soff)
    __omni_bytes_push_u64(out, ssize)
    return 0
}

fn elf64_push_shdr_b(out: int, slink: int, sinfo: int, salign: int, sentsize: int) -> int {
    __omni_bytes_push_u32(out, slink)
    __omni_bytes_push_u32(out, sinfo)
    __omni_bytes_push_u64(out, salign)
    __omni_bytes_push_u64(out, sentsize)
    return 0
}

fn buf_append_buf(dst: int, src: int) -> int {
    let n = __omni_bytes_len(src)
    let i = 0
    while i < n {
        __omni_bytes_push_u8(dst, __omni_bytes_get(src, i))
        i = i + 1
    }
    return 0
}

fn buf_pad_align(buf: int, align: int) -> int {
    let rem = __omni_bytes_len(buf) % align
    if rem != 0 {
        let pad = align - rem
        while pad > 0 {
            __omni_bytes_push_u8(buf, 0)
            pad = pad - 1
        }
    }
    return 0
}

class Compiler {
    src: str
    src_len: int
    tok_kinds: int
    tok_texts: int
    tok_count: int
    pos: int

    globals: int
    extern_names: int
    class_names: int
    field_names: int
    fn_names: int
    fn_params_count: int
    fn_regs_count: int
    fn_ops_bufs: int
    fn_ops_counts: int

    cur_ops: int
    cur_op_count: int
    cur_next_reg: int
    var_names: int
    var_regs: int
    var_is_str: int
    last_expr_is_str: int

    fn init_compiler(self, source: str) -> int {
        self.src = source
        self.src_len = __omni_str_len(source)
        self.tok_kinds = __omni_slice_create(256)
        self.tok_texts = __omni_slice_create(256)
        self.tok_count = 0
        self.pos = 0

        self.globals = __omni_slice_create(32)
        self.extern_names = __omni_slice_create(32)
        __omni_slice_append(self.extern_names, "__omni_print_int")
        __omni_slice_append(self.extern_names, "__omni_print_str")

        self.class_names = __omni_slice_create(8)
        self.field_names = __omni_slice_create(32)
        self.fn_names = __omni_slice_create(64)
        self.fn_params_count = __omni_slice_create(64)
        self.fn_regs_count = __omni_slice_create(64)
        self.fn_ops_bufs = __omni_slice_create(64)
        self.fn_ops_counts = __omni_slice_create(64)

        self.cur_ops = 0
        self.cur_op_count = 0
        self.cur_next_reg = 0
        self.var_names = 0
        self.var_regs = 0
        self.var_is_str = 0
        self.last_expr_is_str = 0
        return 0
    }

    fn push_tok(self, kind: int, text: str) -> int {
        __omni_slice_append(self.tok_kinds, kind)
        __omni_slice_append(self.tok_texts, text)
        self.tok_count = self.tok_count + 1
        return 0
    }

    fn lex(self) -> int {
        let i = 0
        let n = self.src_len
        while i < n {
            let c = __omni_str_byte_at(self.src, i)
            let done = 0
            if done == 0 && (c == 32 || c == 9 || c == 10 || c == 13) {
                i = i + 1
                done = 1
            }
            if done == 0 && c == 47 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 47 {
                while i < n && __omni_str_byte_at(self.src, i) != 10 {
                    i = i + 1
                }
                done = 1
            }
            if done == 0 && c == 35 {
                while i < n && __omni_str_byte_at(self.src, i) != 10 {
                    i = i + 1
                }
                done = 1
            }
            if done == 0 && is_alpha(c) == 1 {
                let start = i
                while i < n && is_alnum(__omni_str_byte_at(self.src, i)) == 1 {
                    i = i + 1
                }
                let word = __omni_str_slice_step(self.src, start, i, 1, 1, 1)
                self.push_tok(1, word)
                done = 1
            }
            if done == 0 && is_digit(c) == 1 {
                let start = i
                while i < n && is_digit(__omni_str_byte_at(self.src, i)) == 1 {
                    i = i + 1
                }
                let num_s = __omni_str_slice_step(self.src, start, i, 1, 1, 1)
                self.push_tok(2, num_s)
                done = 1
            }
            if done == 0 && c == 34 {
                i = i + 1
                let start = i
                while i < n && __omni_str_byte_at(self.src, i) != 34 {
                    i = i + 1
                }
                let s_val = __omni_str_slice_step(self.src, start, i, 1, 1, 1)
                if i < n {
                    i = i + 1
                }
                self.push_tok(3, s_val)
                done = 1
            }
            if done == 0 && c == 45 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 62 {
                self.push_tok(40, "->")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 61 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 61 {
                self.push_tok(31, "==")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 33 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 61 {
                self.push_tok(32, "!=")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 60 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 61 {
                self.push_tok(34, "<=")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 62 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 61 {
                self.push_tok(36, ">=")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 38 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 38 {
                self.push_tok(37, "&&")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 124 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 124 {
                self.push_tok(38, "||")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 58 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 58 {
                self.push_tok(41, "::")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 46 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 46 {
                self.push_tok(42, "..")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 43 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 61 {
                self.push_tok(43, "+=")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 45 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 61 {
                self.push_tok(44, "-=")
                i = i + 2
                done = 1
            }
            if done == 0 && c == 42 && i + 1 < n && __omni_str_byte_at(self.src, i + 1) == 61 {
                self.push_tok(45, "*=")
                i = i + 2
                done = 1
            }
            if done == 0 {
                let k = 0
                if c == 40 {
                    k = 10
                }
                if c == 41 {
                    k = 11
                }
                if c == 123 {
                    k = 12
                }
                if c == 125 {
                    k = 13
                }
                if c == 44 {
                    k = 14
                }
                if c == 58 {
                    k = 15
                }
                if c == 59 {
                    k = 16
                }
                if c == 46 {
                    k = 17
                }
                if c == 43 {
                    k = 20
                }
                if c == 45 {
                    k = 21
                }
                if c == 42 {
                    k = 22
                }
                if c == 47 {
                    k = 23
                }
                if c == 37 {
                    k = 24
                }
                if c == 61 {
                    k = 30
                }
                if c == 60 {
                    k = 33
                }
                if c == 62 {
                    k = 35
                }
                if c == 38 {
                    k = 46
                }
                if c == 33 {
                    k = 47
                }
                if k > 0 {
                    self.push_tok(k, "")
                }
                i = i + 1
            }
        }
        __omni_slice_append(self.tok_kinds, 0)
        __omni_slice_append(self.tok_texts, "")
        return self.tok_count
    }

    fn peek_kind(self) -> int {
        if self.pos >= self.tok_count {
            return 0
        }
        return __omni_slice_get(self.tok_kinds, self.pos)
    }

    fn peek_text(self) -> int {
        if self.pos >= self.tok_count {
            return 0
        }
        return __omni_slice_get(self.tok_texts, self.pos)
    }

    fn peek_at_kind(self, offset: int) -> int {
        let idx = self.pos + offset
        if idx >= self.tok_count {
            return 0
        }
        return __omni_slice_get(self.tok_kinds, idx)
    }

    fn peek_at_text(self, offset: int) -> int {
        let idx = self.pos + offset
        if idx >= self.tok_count {
            return 0
        }
        return __omni_slice_get(self.tok_texts, idx)
    }

    fn advance(self) -> int {
        let k = self.peek_kind()
        if self.pos < self.tok_count {
            self.pos = self.pos + 1
        }
        return k
    }

    fn alloc_reg(self) -> int {
        let r = self.cur_next_reg
        self.cur_next_reg = self.cur_next_reg + 1
        return r
    }

    fn lookup_var(self, name: int) -> int {
        let i = __omni_slice_len(self.var_names) - 1
        while i >= 0 {
            let vn = __omni_slice_get(self.var_names, i)
            if __omni_str_eq(vn, name) == 1 {
                return __omni_slice_get(self.var_regs, i)
            }
            i = i - 1
        }
        return -1
    }

    fn lookup_var_is_str(self, name: int) -> int {
        let i = __omni_slice_len(self.var_names) - 1
        while i >= 0 {
            let vn = __omni_slice_get(self.var_names, i)
            if __omni_str_eq(vn, name) == 1 {
                return __omni_slice_get(self.var_is_str, i)
            }
            i = i - 1
        }
        return 0
    }

    fn lookup_fn(self, name: int) -> int {
        let i = 0
        let n = __omni_slice_len(self.fn_names)
        while i < n {
            let fn_s = __omni_slice_get(self.fn_names, i)
            if __omni_str_eq(fn_s, name) == 1 {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn lookup_extern(self, name: int) -> int {
        let i = 0
        let n = __omni_slice_len(self.extern_names)
        while i < n {
            let ex_s = __omni_slice_get(self.extern_names, i)
            if __omni_str_eq(ex_s, name) == 1 {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn intern_extern(self, name: str) -> int {
        let idx = self.lookup_extern(name)
        if idx >= 0 {
            return idx
        }
        let n = __omni_slice_len(self.extern_names)
        __omni_slice_append(self.extern_names, name)
        return n
    }

    fn lookup_class(self, name: int) -> int {
        let i = 0
        let n = __omni_slice_len(self.class_names)
        while i < n {
            let cn = __omni_slice_get(self.class_names, i)
            if __omni_str_eq(cn, name) == 1 {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn lookup_field(self, name: int) -> int {
        let i = 0
        let n = __omni_slice_len(self.field_names)
        while i < n {
            let fnm = __omni_slice_get(self.field_names, i)
            if __omni_str_eq(fnm, name) == 1 {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn intern_global_str(self, s: int) -> int {
        let i = 0
        let n = __omni_slice_len(self.globals)
        while i < n {
            let gs = __omni_slice_get(self.globals, i)
            if __omni_str_eq(gs, s) == 1 {
                return i
            }
            i = i + 1
        }
        __omni_slice_append(self.globals, s)
        return n
    }

    fn emit_load_imm(self, dst: int, val: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, 1)
        __omni_bytes_push_u16(self.cur_ops, dst)
        __omni_bytes_push_u64(self.cur_ops, val)
        self.cur_op_count = self.cur_op_count + 1
        return dst
    }

    fn emit_load_global(self, dst: int, gidx: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, 2)
        __omni_bytes_push_u16(self.cur_ops, dst)
        __omni_bytes_push_u32(self.cur_ops, gidx)
        self.cur_op_count = self.cur_op_count + 1
        return dst
    }

    fn emit_mov(self, dst: int, src: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, 4)
        __omni_bytes_push_u16(self.cur_ops, dst)
        __omni_bytes_push_u16(self.cur_ops, src)
        self.cur_op_count = self.cur_op_count + 1
        return dst
    }

    fn emit_binop(self, tag: int, dst: int, a: int, b: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, tag)
        __omni_bytes_push_u16(self.cur_ops, dst)
        __omni_bytes_push_u16(self.cur_ops, a)
        __omni_bytes_push_u16(self.cur_ops, b)
        self.cur_op_count = self.cur_op_count + 1
        return dst
    }

    fn emit_icmp(self, cc: int, dst: int, a: int, b: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, 27)
        __omni_bytes_push_u16(self.cur_ops, dst)
        __omni_bytes_push_u8(self.cur_ops, cc)
        __omni_bytes_push_u16(self.cur_ops, a)
        __omni_bytes_push_u16(self.cur_ops, b)
        self.cur_op_count = self.cur_op_count + 1
        return dst
    }

    fn emit_jmp(self, target: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, 61)
        let patch_off = __omni_bytes_len(self.cur_ops)
        __omni_bytes_push_u32(self.cur_ops, target)
        self.cur_op_count = self.cur_op_count + 1
        return patch_off
    }

    fn emit_brif(self, cond: int, true_tgt: int, false_tgt: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, 62)
        __omni_bytes_push_u16(self.cur_ops, cond)
        let patch_off = __omni_bytes_len(self.cur_ops)
        __omni_bytes_push_u32(self.cur_ops, true_tgt)
        __omni_bytes_push_u32(self.cur_ops, false_tgt)
        self.cur_op_count = self.cur_op_count + 1
        return patch_off
    }

    fn emit_ret(self, reg: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, 64)
        __omni_bytes_push_u8(self.cur_ops, 1)
        __omni_bytes_push_u16(self.cur_ops, reg)
        self.cur_op_count = self.cur_op_count + 1
        return 0
    }

    fn emit_call_internal(self, dst: int, fn_idx: int, args: int) -> int {
        __omni_bytes_push_u8(self.cur_ops, 66)
        __omni_bytes_push_u8(self.cur_ops, 1)
        __omni_bytes_push_u16(self.cur_ops, dst)
        __omni_bytes_push_u32(self.cur_ops, fn_idx)
        let na = __omni_slice_len(args)
