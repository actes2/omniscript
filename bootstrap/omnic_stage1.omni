                    __omni_bytes_push_u8(text, 242)
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, 16)
                    __omni_bytes_push_u8(text, 133)
                    __omni_bytes_push_u32(text, x64_slot_disp(op_l))
                    __omni_bytes_push_u8(text, 102)
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, 46)
                    __omni_bytes_push_u8(text, 133)
                    __omni_bytes_push_u32(text, x64_slot_disp(op_r))
                    if cc == 0 {
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 148)
                        __omni_bytes_push_u8(text, 192)
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 155)
                        __omni_bytes_push_u8(text, 193)
                        __omni_bytes_push_u8(text, 32)
                        __omni_bytes_push_u8(text, 200)
                    }
                    if cc == 1 {
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 149)
                        __omni_bytes_push_u8(text, 192)
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 154)
                        __omni_bytes_push_u8(text, 193)
                        __omni_bytes_push_u8(text, 8)
                        __omni_bytes_push_u8(text, 200)
                    }
                    if cc == 2 || cc == 4 {
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 151)
                        __omni_bytes_push_u8(text, 192)
                    }
                    if cc == 3 || cc == 5 {
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 147)
                        __omni_bytes_push_u8(text, 192)
                    }
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, 182)
                    __omni_bytes_push_u8(text, 192)
                    x64_store_rax(text, dst)
                }
                if tag == 27 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let cc = __omni_bytes_get(ops_buf, cur + 2)
                    let a = x64_read_u16(ops_buf, cur + 3)
                    let b = x64_read_u16(ops_buf, cur + 5)
                    cur = cur + 7
                    x64_load_rax(text, a)
                    __omni_bytes_push_u8(text, 72)
                    __omni_bytes_push_u8(text, 59)
                    __omni_bytes_push_u8(text, 133)
                    __omni_bytes_push_u32(text, x64_slot_disp(b))
                    let set_op = 148
                    if cc == 1 {
                        set_op = 149
                    }
                    if cc == 2 {
                        set_op = 156
                    }
                    if cc == 3 {
                        set_op = 158
                    }
                    if cc == 4 {
                        set_op = 159
                    }
                    if cc == 5 {
                        set_op = 157
                    }
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, set_op)
                    __omni_bytes_push_u8(text, 192)
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, 182)
                    __omni_bytes_push_u8(text, 192)
                    x64_store_rax(text, dst)
                }
                if tag == 61 {
                    let tgt = x64_read_u32(ops_buf, cur)
                    cur = cur + 4
                    __omni_bytes_push_u8(text, 233)
                    let poff = __omni_bytes_len(text)
                    __omni_bytes_push_u32(text, 0)
                    __omni_slice_append(bp_offs, poff)
                    __omni_slice_append(bp_tgts, tgt)
