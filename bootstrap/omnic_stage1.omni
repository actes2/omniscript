        // DOS Header (64 bytes)
        __omni_bytes_push_str(out, "MZ")
        let di = 2
        while di < 60 {
            __omni_bytes_push_u8(out, 0)
            di = di + 1
        }
        __omni_bytes_push_u32(out, 64)
        // PE Signature + COFF Header (24 bytes)
        __omni_bytes_push_str(out, "PE")
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u16(out, 0x8664)
        __omni_bytes_push_u16(out, 3)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u16(out, 240)
        __omni_bytes_push_u16(out, 0x0022)
        // Optional Header PE32+ (240 bytes)
        __omni_bytes_push_u16(out, 0x020B)
        __omni_bytes_push_u8(out, 1)
        __omni_bytes_push_u8(out, 0)
        __omni_bytes_push_u32(out, text_rsz)
        __omni_bytes_push_u32(out, rdata_rsz + idata_rsz)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, text_rva)
        __omni_bytes_push_u32(out, text_rva)
        __omni_bytes_push_u64(out, 0x00400000)
        __omni_bytes_push_u32(out, 0x1000)
        __omni_bytes_push_u32(out, 0x200)
        __omni_bytes_push_u16(out, 6)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u16(out, 6)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, size_of_image)
        __omni_bytes_push_u32(out, 0x200)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u16(out, 3)
        __omni_bytes_push_u16(out, 0)
        __omni_bytes_push_u64(out, 0x100000)
        __omni_bytes_push_u64(out, 0x1000)
        __omni_bytes_push_u64(out, 0x100000)
        __omni_bytes_push_u64(out, 0x1000)
        __omni_bytes_push_u32(out, 0)
        __omni_bytes_push_u32(out, 16)
        // 16 Data Directories (128 bytes): [1] Import Table, [12] IAT
        let ddi = 0
        while ddi < 16 {
            if ddi == 1 {
                __omni_bytes_push_u32(out, idata_rva)
                __omni_bytes_push_u32(out, 40)
            }
            if ddi == 12 {
                __omni_bytes_push_u32(out, idata_rva + 0x48)
                __omni_bytes_push_u32(out, 32)
            }
            if ddi != 1 && ddi != 12 {
                __omni_bytes_push_u32(out, 0)
                __omni_bytes_push_u32(out, 0)
            }
            ddi = ddi + 1
        }
        // 3 Section Headers
        pe_push_sec_a(out, ".text", text_vsz, text_rva, text_rsz, text_rptr)
        pe_push_sec_b(out, 0x60000020)
        pe_push_sec_a(out, ".rdata", rdata_vsz, rdata_rva, rdata_rsz, rdata_rptr)
        pe_push_sec_b(out, 0x40000040)
        pe_push_sec_a(out, ".idata", idata_vsz, idata_rva, idata_rsz, idata_rptr)
        pe_push_sec_b(out, 0xC0000040)

        buf_pad_align(out, 512)
        buf_append_buf(out, text)
        buf_pad_align(out, 512)
        buf_append_buf(out, rdata)
        buf_pad_align(out, 512)
        buf_append_buf(out, idata)
        buf_pad_align(out, 512)

        __omni_bytes_destroy(text)
        __omni_bytes_destroy(rdata)
        __omni_bytes_destroy(idata)
        return out
    }

    fn emit_uf2_rp2350(self) -> int {
        let nf = __omni_slice_len(self.fn_names)
        let main_fidx = 0
        let mi = 0
        while mi < nf {
            if str_eq_raw(__omni_slice_get(self.fn_names, mi), "main") == 1 {
                main_fidx = mi
            }
            mi = mi + 1
        }

        let flash = __omni_bytes_create(8192)
        // Vector Table (256 bytes = 64 words): MSP = 0x2008_2000, Reset = 0x1000_0121
        __omni_bytes_push_u32(flash, 0x20082000)
        let vi = 1
        while vi < 64 {
            __omni_bytes_push_u32(flash, 0x10000121)
            vi = vi + 1
        }
        // Mandatory RP2350 PICOBIN IMAGE_DEF block at 0x100..0x114
        __omni_bytes_push_u32(flash, 0xFFFFDED3)
        __omni_bytes_push_u32(flash, 0x10210142)
        __omni_bytes_push_u32(flash, 0x000001FF)
        __omni_bytes_push_u32(flash, 0x00000000)
        __omni_bytes_push_u32(flash, 0xAB123579)
        __omni_bytes_push_u32(flash, 0)
        __omni_bytes_push_u32(flash, 0)
        __omni_bytes_push_u32(flash, 0)

        // Reset_Handler at 0x120: bl main; wfi; b .-2
        let reset_bl_off = __omni_bytes_len(flash)
        __omni_bytes_push_u32(flash, 0)
        __omni_bytes_push_u16(flash, 0xBF30)
        __omni_bytes_push_u16(flash, 0xE7FD)

        let fn_offs = __omni_slice_create(nf + 1)
        let call_patches_off = __omni_slice_create(64)
        let call_patches_fidx = __omni_slice_create(64)
        __omni_slice_append(call_patches_off, reset_bl_off)
        __omni_slice_append(call_patches_fidx, main_fidx)

        let fi = 0
        while fi < nf {
            buf_pad_align(flash, 4)
            __omni_slice_append(fn_offs, __omni_bytes_len(flash))
            let nparams = __omni_slice_get(self.fn_params_count, fi)
            let nregs = __omni_slice_get(self.fn_regs_count, fi)
            if nregs < 5 {
                nregs = 5
            }
            if (nregs % 2) == 0 {
                nregs = nregs + 1
            }
            __omni_bytes_push_u16(flash, 0xB5F0)
            let rem_sp = nregs
            while rem_sp > 0 {
                let chunk = rem_sp
                if chunk > 127 {
                    chunk = 127
                }
                __omni_bytes_push_u16(flash, 0xB080 | chunk)
                rem_sp = rem_sp - chunk
            }
            let pi = 0
            while pi < nparams {
                __omni_bytes_push_u16(flash, 0x9000 | (pi << 8) | (pi & 0xFF))
                pi = pi + 1
            }

            let ops_buf = __omni_slice_get(self.fn_ops_bufs, fi)
            let op_count = __omni_slice_get(self.fn_ops_counts, fi)
            let pc_to_off = __omni_slice_create(op_count + 1)
            let bp_offs = __omni_slice_create(32)
            let bp_tgts = __omni_slice_create(32)

            let cur = 0
            let oi = 0
            while oi < op_count {
                __omni_slice_append(pc_to_off, __omni_bytes_len(flash))
                let tag = __omni_bytes_get(ops_buf, cur)
                cur = cur + 1
                if tag == 1 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let lo16 = x64_read_u16(ops_buf, cur + 2)
                    let hi16 = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 10
                    thumb_push_movw_r0(flash, lo16)
                    if hi16 != 0 {
                        thumb_push_movt_r0(flash, hi16)
                    }
                    __omni_bytes_push_u16(flash, 0x9000 | (dst & 0xFF))
                }
                if tag == 2 {
                    let dst = x64_read_u16(ops_buf, cur)
                    cur = cur + 6
                    thumb_push_movw_r0(flash, 0)
                    __omni_bytes_push_u16(flash, 0x9000 | (dst & 0xFF))
                }
                if tag == 4 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let src = x64_read_u16(ops_buf, cur + 2)
                    cur = cur + 4
                    __omni_bytes_push_u16(flash, 0x9800 | (src & 0xFF))
                    __omni_bytes_push_u16(flash, 0x9000 | (dst & 0xFF))
                }
                if tag == 12 || tag == 13 || tag == 14 || tag == 15 || tag == 17 || (tag >= 19 && tag <= 24) {
                    let dst = x64_read_u16(ops_buf, cur)
                    let a = x64_read_u16(ops_buf, cur + 2)
                    let b = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 6
                    __omni_bytes_push_u16(flash, 0x9800 | (a & 0xFF))
                    __omni_bytes_push_u16(flash, 0x9900 | (b & 0xFF))
                    if tag == 12 {
                        __omni_bytes_push_u16(flash, 0x1840)
                    }
                    if tag == 13 {
                        __omni_bytes_push_u16(flash, 0x1A40)
                    }
                    if tag == 14 {
                        __omni_bytes_push_u16(flash, 0x4348)
                    }
                    if tag == 15 {
                        __omni_bytes_push_u16(flash, 0xFB90)
                        __omni_bytes_push_u16(flash, 0xF0F1)
                    }
                    if tag == 17 {
                        __omni_bytes_push_u16(flash, 0xFB90)
                        __omni_bytes_push_u16(flash, 0xF2F1)
                        __omni_bytes_push_u16(flash, 0xFB02)
                        __omni_bytes_push_u16(flash, 0x0011)
                    }
                    if tag == 19 {
                        __omni_bytes_push_u16(flash, 0x4008)
                    }
                    if tag == 20 {
                        __omni_bytes_push_u16(flash, 0x4308)
                    }
                    if tag == 21 {
                        __omni_bytes_push_u16(flash, 0x4048)
                    }
                    if tag == 22 {
                        __omni_bytes_push_u16(flash, 0x4088)
                    }
                    if tag == 23 {
                        __omni_bytes_push_u16(flash, 0x4108)
                    }
                    if tag == 24 {
                        __omni_bytes_push_u16(flash, 0x40C8)
                    }
                    __omni_bytes_push_u16(flash, 0x9000 | (dst & 0xFF))
                }
                if tag == 27 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let cc = __omni_bytes_get(ops_buf, cur + 2)
                    let a = x64_read_u16(ops_buf, cur + 3)
                    let b = x64_read_u16(ops_buf, cur + 5)
                    cur = cur + 7
                    __omni_bytes_push_u16(flash, 0x9800 | (a & 0xFF))
                    __omni_bytes_push_u16(flash, 0x9900 | (b & 0xFF))
                    __omni_bytes_push_u16(flash, 0x2200)
                    __omni_bytes_push_u16(flash, 0x4288)
                    let inv = 1
                    if cc == 1 {
                        inv = 0
                    }
                    if cc == 2 {
                        inv = 10
                    }
                    if cc == 3 {
                        inv = 12
                    }
                    if cc == 4 {
                        inv = 13
                    }
                    if cc == 5 {
                        inv = 11
                    }
                    __omni_bytes_push_u16(flash, 0xD000 | (inv << 8))
                    __omni_bytes_push_u16(flash, 0x2201)
                    __omni_bytes_push_u16(flash, 0x9200 | (dst & 0xFF))
                }
                if tag == 61 {
                    let tgt = x64_read_u32(ops_buf, cur)
                    cur = cur + 4
                    __omni_slice_append(bp_offs, __omni_bytes_len(flash))
                    __omni_slice_append(bp_tgts, tgt)
                    __omni_bytes_push_u32(flash, 0)
                }
                if tag == 62 {
                    let cond = x64_read_u16(ops_buf, cur)
                    let t_tgt = x64_read_u32(ops_buf, cur + 2)
                    let f_tgt = x64_read_u32(ops_buf, cur + 6)
                    cur = cur + 10
                    __omni_bytes_push_u16(flash, 0x9800 | (cond & 0xFF))
                    __omni_bytes_push_u16(flash, 0x2800)
                    __omni_bytes_push_u16(flash, 0xD001)
                    __omni_slice_append(bp_offs, __omni_bytes_len(flash))
                    __omni_slice_append(bp_tgts, t_tgt)
                    __omni_bytes_push_u32(flash, 0)
                    __omni_slice_append(bp_offs, __omni_bytes_len(flash))
                    __omni_slice_append(bp_tgts, f_tgt)
                    __omni_bytes_push_u32(flash, 0)
                }
                if tag == 64 {
                    let has_v = __omni_bytes_get(ops_buf, cur)
                    cur = cur + 1
                    if has_v == 1 {
                        let r = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                        __omni_bytes_push_u16(flash, 0x9800 | (r & 0xFF))
                    }
                    let rem_sp2 = nregs
                    while rem_sp2 > 0 {
                        let chunk2 = rem_sp2
                        if chunk2 > 127 {
                            chunk2 = 127
                        }
                        __omni_bytes_push_u16(flash, 0xB000 | chunk2)
                        rem_sp2 = rem_sp2 - chunk2
                    }
                    __omni_bytes_push_u16(flash, 0xBDF0)
                }
                if tag == 66 {
                    let has_dst = __omni_bytes_get(ops_buf, cur)
                    cur = cur + 1
                    let dst = 0
                    if has_dst == 1 {
                        dst = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                    }
                    let cfidx = x64_read_u32(ops_buf, cur)
                    let na = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 6
                    let ai = 0
                    while ai < na {
                        let areg = x64_read_u16(ops_buf, cur)
                        cur = cur + 2
                        __omni_bytes_push_u16(flash, 0x9800 | (ai << 8) | (areg & 0xFF))
                        ai = ai + 1
                    }
                    __omni_slice_append(call_patches_off, __omni_bytes_len(flash))
                    __omni_slice_append(call_patches_fidx, cfidx)
                    __omni_bytes_push_u32(flash, 0)
                    if has_dst == 1 {
                        __omni_bytes_push_u16(flash, 0x9000 | (dst & 0xFF))
                    }
                }
                if (tag >= 29 && tag <= 32) || tag == 39 {
                    print("omnic_stage1 error: f64 ops not supported in bare-metal UF2 backend")
                    __omni_bytes_destroy(flash)
                    return 0
                }
                if tag == 67 {
                    print("omnic_stage1 error: unsupported extern call in bare-metal UF2 backend")
                    __omni_bytes_destroy(flash)
                    return 0
                }
                oi = oi + 1
            }

            let nbp = __omni_slice_len(bp_offs)
            let bpi = 0
            while bpi < nbp {
                let poff = __omni_slice_get(bp_offs, bpi)
                let tgt = __omni_slice_get(bp_tgts, bpi)
                let toff = __omni_slice_get(pc_to_off, tgt)
                thumb_patch_b32(flash, poff, toff, 0)
                bpi = bpi + 1
            }

            __omni_bytes_destroy(ops_buf)
            fi = fi + 1
        }

        let ncp = __omni_slice_len(call_patches_off)
        let cpi = 0
        while cpi < ncp {
            let poff = __omni_slice_get(call_patches_off, cpi)
            let cfidx = __omni_slice_get(call_patches_fidx, cpi)
            let toff = __omni_slice_get(fn_offs, cfidx)
            thumb_patch_b32(flash, poff, toff, 1)
            cpi = cpi + 1
        }

        // Frame flash image into 512-byte UF2 blocks for RP2350 (0xE48B_FF59)
        let flen = __omni_bytes_len(flash)
        let nblks = (flen + 255) / 256
        let uf2 = __omni_bytes_create(nblks * 512)
        let bi = 0
        while bi < nblks {
            __omni_bytes_push_u32(uf2, 0x0A324655)
            __omni_bytes_push_u32(uf2, 0x9E5D5157)
            __omni_bytes_push_u32(uf2, 0x00002000)
            __omni_bytes_push_u32(uf2, 0x10000000 + bi * 256)
            __omni_bytes_push_u32(uf2, 256)
            __omni_bytes_push_u32(uf2, bi)
            __omni_bytes_push_u32(uf2, nblks)
            __omni_bytes_push_u32(uf2, 0xE48BFF59)
            let pi = 0
            while pi < 476 {
                let foff = bi * 256 + pi
                if pi < 256 && foff < flen {
                    __omni_bytes_push_u8(uf2, __omni_bytes_get(flash, foff))
                } else {
                    __omni_bytes_push_u8(uf2, 0)
                }
                pi = pi + 1
            }
            __omni_bytes_push_u32(uf2, 0x0AB16F30)
            bi = bi + 1
        }
        __omni_bytes_destroy(flash)
        return uf2
    }

    fn emit_elf64_exec_x86_64(self) -> int {
        let nf = __omni_slice_len(self.fn_names)
        let rodata = __omni_bytes_create(1024)
        let global_offs = __omni_slice_create(64)
        let ng = __omni_slice_len(self.globals)
        let gi = 0
        while gi < ng {
            __omni_slice_append(global_offs, __omni_bytes_len(rodata))
            __omni_bytes_push_str(rodata, __omni_slice_get(self.globals, gi))
            __omni_bytes_push_u8(rodata, 0)
            gi = gi + 1
        }
        if __omni_bytes_len(rodata) == 0 {
            __omni_bytes_push_u8(rodata, 0)
        }

        let main_fidx = 0
        let mi = 0
        while mi < nf {
            if str_eq_raw(__omni_slice_get(self.fn_names, mi), "main") == 1 {
                main_fidx = mi
            }
            mi = mi + 1
        }

        let text = __omni_bytes_create(16384)
        let rdata_patches_off = __omni_slice_create(64)
        let rdata_patches_goff = __omni_slice_create(64)
        let fn_patches_off = __omni_slice_create(128)
        let fn_patches_fidx = __omni_slice_create(128)

        // _start at text+0 (VMA 0x400078): call main; mov rdi, rax; mov eax, 60; syscall
        __omni_bytes_push_u8(text, 232)
        __omni_slice_append(fn_patches_off, __omni_bytes_len(text))
        __omni_slice_append(fn_patches_fidx, main_fidx)
        __omni_bytes_push_u32(text, 0)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 137)
        __omni_bytes_push_u8(text, 199)
        __omni_bytes_push_u8(text, 184)
        __omni_bytes_push_u32(text, 60)
        __omni_bytes_push_u8(text, 15)
        __omni_bytes_push_u8(text, 5)

        // Builtin __omni_print_str(rdi = str_ptr) via Linux sys_write(1, ptr, len)
        let pstr_off = __omni_bytes_len(text)
        __omni_bytes_push_u8(text, 85)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 137)
        __omni_bytes_push_u8(text, 229)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 131)
        __omni_bytes_push_u8(text, 236)
        __omni_bytes_push_u8(text, 32)
        // rdx = strlen(rdi)
        __omni_bytes_push_u8(text, 49)
        __omni_bytes_push_u8(text, 210)
        let sl_loop = __omni_bytes_len(text)
        __omni_bytes_push_u8(text, 128)
        __omni_bytes_push_u8(text, 60)
        __omni_bytes_push_u8(text, 23)
        __omni_bytes_push_u8(text, 0)
        __omni_bytes_push_u8(text, 15)
        __omni_bytes_push_u8(text, 132)
        let sl_je = __omni_bytes_len(text)
        __omni_bytes_push_u32(text, 0)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 131)
        __omni_bytes_push_u8(text, 194)
        __omni_bytes_push_u8(text, 1)
        __omni_bytes_push_u8(text, 233)
        let sl_jmp = __omni_bytes_len(text)
        __omni_bytes_push_u32(text, sl_loop - (sl_jmp + 4))
        let sl_done = __omni_bytes_len(text)
        __omni_bytes_patch_u32(text, sl_je, sl_done - (sl_je + 4))
        // sys_write(1, rdi, rdx)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 137)
        __omni_bytes_push_u8(text, 254)
        __omni_bytes_push_u8(text, 191)
        __omni_bytes_push_u32(text, 1)
        __omni_bytes_push_u8(text, 184)
        __omni_bytes_push_u32(text, 1)
        __omni_bytes_push_u8(text, 15)
        __omni_bytes_push_u8(text, 5)
        // sys_write(1, &nl, 1)
        __omni_bytes_push_u8(text, 198)
        __omni_bytes_push_u8(text, 69)
        __omni_bytes_push_u8(text, 248)
        __omni_bytes_push_u8(text, 10)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 141)
        __omni_bytes_push_u8(text, 117)
        __omni_bytes_push_u8(text, 248)
        __omni_bytes_push_u8(text, 191)
        __omni_bytes_push_u32(text, 1)
        __omni_bytes_push_u8(text, 186)
        __omni_bytes_push_u32(text, 1)
        __omni_bytes_push_u8(text, 184)
        __omni_bytes_push_u32(text, 1)
        __omni_bytes_push_u8(text, 15)
        __omni_bytes_push_u8(text, 5)
        __omni_bytes_push_u8(text, 201)
        __omni_bytes_push_u8(text, 195)

        // Builtin __omni_print_int(rdi = i64 val)
        let pint_off = __omni_bytes_len(text)
        __omni_bytes_push_u8(text, 85)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 137)
        __omni_bytes_push_u8(text, 229)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 131)
        __omni_bytes_push_u8(text, 236)
        __omni_bytes_push_u8(text, 48)
        __omni_bytes_push_u8(text, 76)
        __omni_bytes_push_u8(text, 141)
        __omni_bytes_push_u8(text, 69)
        __omni_bytes_push_u8(text, 255)
        __omni_bytes_push_u8(text, 65)
        __omni_bytes_push_u8(text, 198)
        __omni_bytes_push_u8(text, 0)
        __omni_bytes_push_u8(text, 0)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 137)
        __omni_bytes_push_u8(text, 248)
        __omni_bytes_push_u8(text, 69)
        __omni_bytes_push_u8(text, 49)
        __omni_bytes_push_u8(text, 201)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 133)
        __omni_bytes_push_u8(text, 192)
        __omni_bytes_push_u8(text, 15)
        __omni_bytes_push_u8(text, 141)
        let p_jge = __omni_bytes_len(text)
        __omni_bytes_push_u32(text, 0)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 247)
        __omni_bytes_push_u8(text, 216)
        __omni_bytes_push_u8(text, 65)
        __omni_bytes_push_u8(text, 185)
        __omni_bytes_push_u32(text, 1)
        let p_lbl = __omni_bytes_len(text)
        __omni_bytes_patch_u32(text, p_jge, p_lbl - (p_jge + 4))
        __omni_bytes_push_u8(text, 65)
        __omni_bytes_push_u8(text, 186)
        __omni_bytes_push_u32(text, 10)
        let dl = __omni_bytes_len(text)
        __omni_bytes_push_u8(text, 49)
        __omni_bytes_push_u8(text, 210)
        __omni_bytes_push_u8(text, 73)
        __omni_bytes_push_u8(text, 247)
        __omni_bytes_push_u8(text, 242)
        __omni_bytes_push_u8(text, 128)
        __omni_bytes_push_u8(text, 194)
        __omni_bytes_push_u8(text, 48)
        __omni_bytes_push_u8(text, 73)
        __omni_bytes_push_u8(text, 131)
        __omni_bytes_push_u8(text, 232)
        __omni_bytes_push_u8(text, 1)
        __omni_bytes_push_u8(text, 65)
        __omni_bytes_push_u8(text, 136)
        __omni_bytes_push_u8(text, 16)
        __omni_bytes_push_u8(text, 72)
        __omni_bytes_push_u8(text, 133)
        __omni_bytes_push_u8(text, 192)
        __omni_bytes_push_u8(text, 15)
        __omni_bytes_push_u8(text, 133)
        let dl_jnz = __omni_bytes_len(text)
        __omni_bytes_push_u32(text, dl - (dl_jnz + 4))
        __omni_bytes_push_u8(text, 77)
        __omni_bytes_push_u8(text, 133)
        __omni_bytes_push_u8(text, 201)
        __omni_bytes_push_u8(text, 15)
        __omni_bytes_push_u8(text, 132)
        let n_jz = __omni_bytes_len(text)
        __omni_bytes_push_u32(text, 0)
        __omni_bytes_push_u8(text, 73)
        __omni_bytes_push_u8(text, 131)
        __omni_bytes_push_u8(text, 232)
        __omni_bytes_push_u8(text, 1)
        __omni_bytes_push_u8(text, 65)
        __omni_bytes_push_u8(text, 198)
        __omni_bytes_push_u8(text, 0)
        __omni_bytes_push_u8(text, 45)
        let n_done = __omni_bytes_len(text)
        __omni_bytes_patch_u32(text, n_jz, n_done - (n_jz + 4))
        __omni_bytes_push_u8(text, 76)
        __omni_bytes_push_u8(text, 137)
        __omni_bytes_push_u8(text, 199)
        __omni_bytes_push_u8(text, 232)
        let c_pstr = __omni_bytes_len(text)
        __omni_bytes_push_u32(text, pstr_off - (c_pstr + 4))
        __omni_bytes_push_u8(text, 201)
        __omni_bytes_push_u8(text, 195)

        let fn_text_offs = __omni_slice_create(nf + 1)
        let fi = 0
        while fi < nf {
            let f_start = __omni_bytes_len(text)
            __omni_slice_append(fn_text_offs, f_start)
            let nparams = __omni_slice_get(self.fn_params_count, fi)
            let nregs = __omni_slice_get(self.fn_regs_count, fi)
            let frame_sz = ((nregs * 8 + 15) / 16) * 16
            if frame_sz < 16 {
                frame_sz = 16
            }
            __omni_bytes_push_u8(text, 85)
            __omni_bytes_push_u8(text, 72)
            __omni_bytes_push_u8(text, 137)
            __omni_bytes_push_u8(text, 229)
            __omni_bytes_push_u8(text, 72)
            __omni_bytes_push_u8(text, 129)
            __omni_bytes_push_u8(text, 236)
            __omni_bytes_push_u32(text, frame_sz)

            let pi = 0
            while pi < nparams {
                x64_store_arg_reg(text, pi, pi)
                pi = pi + 1
            }

            let ops_buf = __omni_slice_get(self.fn_ops_bufs, fi)
            let op_count = __omni_slice_get(self.fn_ops_counts, fi)
            let pc_to_off = __omni_slice_create(op_count + 1)
            let bp_offs = __omni_slice_create(32)
            let bp_tgts = __omni_slice_create(32)

            let cur = 0
            let oi = 0
            while oi < op_count {
                __omni_slice_append(pc_to_off, __omni_bytes_len(text))
                let tag = __omni_bytes_get(ops_buf, cur)
                cur = cur + 1
                if tag == 1 {
                    let dst = x64_read_u16(ops_buf, cur)
                    cur = cur + 2
                    __omni_bytes_push_u8(text, 72)
                    __omni_bytes_push_u8(text, 184)
                    let bi = 0
                    while bi < 8 {
