                        __omni_slice_append(aargs, zero_r)
                        self.emit_call_extern(0, 0, app_ext, aargs)
                        fi = fi + 1
                    }
                    self.last_expr_is_str = 0
                    return self.parse_postfix(obj_r)
                }
                let args = __omni_slice_create(8)
                let first_arg_is_str = 0
                let first_arg_is_float = 0
                let argc = 0
                while self.peek_kind() != 11 && self.peek_kind() != 0 {
                    let ar = self.parse_expr()
                    if argc == 0 {
                        first_arg_is_str = self.last_expr_is_str
                        first_arg_is_float = self.last_expr_is_float
                    }
                    __omni_slice_append(args, ar)
                    argc = argc + 1
                    if self.peek_kind() == 14 {
