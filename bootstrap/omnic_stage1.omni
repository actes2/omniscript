                let dst = self.alloc_reg()
                lhs = self.emit_call_extern(1, dst, cat_ext, cargs)
                self.last_expr_is_str = 1
                self.last_expr_is_float = 0
                self.last_expr_is_map = 0
            } else {
                let is_f = 0
                if lhs_f == 1 || self.last_expr_is_float == 1 {
                    is_f = 1
                }
                let dst = self.alloc_reg()
                let tag = 12
                if op == 21 {
                    tag = 13
                }
                if is_f == 1 {
                    tag = 29
                    if op == 21 {
                        tag = 30
                    }
                }
                lhs = self.emit_binop(tag, dst, lhs, rhs)
                self.last_expr_is_str = 0
                self.last_expr_is_float = is_f
                self.last_expr_is_map = 0
            }
        }
        return lhs
    }

    fn parse_shift(self) -> int {
        let lhs = self.parse_add()
        while self.peek_kind() == 48 || self.peek_kind() == 49 {
            let op = self.advance()
            let rhs = self.parse_add()
            let dst = self.alloc_reg()
            let tag = 22
            if op == 49 {
                tag = 23
            }
            lhs = self.emit_binop(tag, dst, lhs, rhs)
            self.clear_expr_types()
        }
        return lhs
    }

    fn parse_bitand(self) -> int {
        let lhs = self.parse_shift()
        while self.peek_kind() == 46 {
            self.advance()
            let rhs = self.parse_shift()
            let dst = self.alloc_reg()
            lhs = self.emit_binop(19, dst, lhs, rhs)
            self.clear_expr_types()
        }
        return lhs
