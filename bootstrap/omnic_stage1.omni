    fn parse_bitxor(self) -> int {
        let lhs = self.parse_bitand()
        while self.peek_kind() == 51 {
            self.advance()
            let rhs = self.parse_bitand()
            let dst = self.alloc_reg()
            lhs = self.emit_binop(21, dst, lhs, rhs)
            self.clear_expr_types()
        }
        return lhs
    }

    fn parse_bitor(self) -> int {
        let lhs = self.parse_bitxor()
        while self.peek_kind() == 50 {
            self.advance()
            let rhs = self.parse_bitxor()
            let dst = self.alloc_reg()
            lhs = self.emit_binop(20, dst, lhs, rhs)
