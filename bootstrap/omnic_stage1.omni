    fn parse_mul(self) -> int {
        let lhs = self.parse_primary()
        while self.peek_kind() == 22 || self.peek_kind() == 23 || self.peek_kind() == 24 {
            let lhs_f = self.last_expr_is_float
            let op = self.advance()
            let rhs = self.parse_primary()
            let is_f = 0
            if lhs_f == 1 || self.last_expr_is_float == 1 {
                is_f = 1
            }
            let dst = self.alloc_reg()
            let tag = 14
            if op == 23 {
                tag = 15
            }
            if op == 24 {
                tag = 17
            }
            if is_f == 1 {
                if op == 22 {
                    tag = 31
                }
                if op == 23 {
                    tag = 32
                }
            }
            lhs = self.emit_binop(tag, dst, lhs, rhs)
            self.last_expr_is_str = 0
            self.last_expr_is_float = is_f
            self.last_expr_is_map = 0
        }
        return lhs
    }

    fn parse_add(self) -> int {
        let lhs = self.parse_mul()
        while self.peek_kind() == 20 || self.peek_kind() == 21 {
            let lhs_s = self.last_expr_is_str
            let lhs_f = self.last_expr_is_float
            let op = self.advance()
            let rhs = self.parse_mul()
            if op == 20 && (lhs_s == 1 || self.last_expr_is_str == 1) {
                let cargs = __omni_slice_create(2)
                __omni_slice_append(cargs, lhs)
                __omni_slice_append(cargs, rhs)
