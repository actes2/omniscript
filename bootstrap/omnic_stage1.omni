                    if tag == 13 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 41)
                        __omni_bytes_push_u8(text, 200)
                        x64_store_rax(text, dst)
                    }
                    if tag == 14 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 175)
                        __omni_bytes_push_u8(text, 193)
                        x64_store_rax(text, dst)
                    }
                    if tag == 15 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 153)
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 247)
                        __omni_bytes_push_u8(text, 249)
                        x64_store_rax(text, dst)
                    }
                    if tag == 17 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 153)
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 247)
                        __omni_bytes_push_u8(text, 249)
