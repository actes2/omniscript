fn is_alpha(c: int) -> int {
    if c >= 65 && c <= 90 {
        return 1
    }
    if c >= 97 && c <= 122 {
        return 1
    }
    if c == 95 {
        return 1
    }
    return 0
}

fn is_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return 1
    }
    return 0
}

fn is_alnum(c: int) -> int {
    if is_alpha(c) == 1 {
        return 1
    }
    if is_digit(c) == 1 {
        return 1
    }
    return 0
}

fn is_hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return 1
    }
    if c >= 65 && c <= 70 {
        return 1
    }
    if c >= 97 && c <= 102 {
        return 1
    }
    return 0
}

fn parse_int_lit(s: int) -> int {
    let n = __omni_str_len(s)
    if n >= 2 && __omni_str_byte_at(s, 0) == 48 {
        let c1 = __omni_str_byte_at(s, 1)
        if c1 == 120 || c1 == 88 {
            let acc = 0
            let i = 2
            while i < n {
                let c = __omni_str_byte_at(s, i)
                if c >= 48 && c <= 57 {
                    acc = acc * 16 + (c - 48)
                }
                if c >= 65 && c <= 70 {
                    acc = acc * 16 + (c - 55)
                }
                if c >= 97 && c <= 102 {
                    acc = acc * 16 + (c - 87)
                }
                i = i + 1
            }
            return acc
        }
        if c1 == 98 || c1 == 66 {
            let acc = 0
            let i = 2
            while i < n {
                let c = __omni_str_byte_at(s, i)
                if c == 48 {
                    acc = acc * 2
                }
                if c == 49 {
                    acc = acc * 2 + 1
                }
                i = i + 1
            }
            return acc
        }
    }
    let acc = 0
    let i = 0
    while i < n {
        let c = __omni_str_byte_at(s, i)
        if c >= 48 && c <= 57 {
            acc = acc * 10 + (c - 48)
        }
        i = i + 1
    }
    return acc
}

fn str_eq_raw(a: int, b: str) -> int {
    return __omni_str_eq(a, b)
}

fn x64_read_u16(buf: int, off: int) -> int {
    let b0 = __omni_bytes_get(buf, off)
    let b1 = __omni_bytes_get(buf, off + 1)
    return b0 + b1 * 256
}

fn x64_read_u32(buf: int, off: int) -> int {
    let b0 = __omni_bytes_get(buf, off)
    let b1 = __omni_bytes_get(buf, off + 1)
    let b2 = __omni_bytes_get(buf, off + 2)
    let b3 = __omni_bytes_get(buf, off + 3)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

fn x64_slot_disp(reg: int) -> int {
    return 0 - (reg + 1) * 8
}

fn x64_load_rax(text: int, reg: int) -> int {
    __omni_bytes_push_u8(text, 72)
    __omni_bytes_push_u8(text, 139)
    __omni_bytes_push_u8(text, 133)
    __omni_bytes_push_u32(text, x64_slot_disp(reg))
    return 0
}

fn x64_store_rax(text: int, reg: int) -> int {
    __omni_bytes_push_u8(text, 72)
    __omni_bytes_push_u8(text, 137)
    __omni_bytes_push_u8(text, 133)
    __omni_bytes_push_u32(text, x64_slot_disp(reg))
    return 0
}

fn x64_load_rcx(text: int, reg: int) -> int {
    __omni_bytes_push_u8(text, 72)
    __omni_bytes_push_u8(text, 139)
    __omni_bytes_push_u8(text, 141)
    __omni_bytes_push_u32(text, x64_slot_disp(reg))
