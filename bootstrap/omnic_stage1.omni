fn pe_push_sec_a(out: int, name: str, vsz: int, vaddr: int, rsz: int, rptr: int) -> int {
    let nlen = __omni_str_len(name)
    __omni_bytes_push_str(out, name)
    let pad = 8 - nlen
    while pad > 0 {
        __omni_bytes_push_u8(out, 0)
        pad = pad - 1
    }
    __omni_bytes_push_u32(out, vsz)
    __omni_bytes_push_u32(out, vaddr)
    __omni_bytes_push_u32(out, rsz)
    __omni_bytes_push_u32(out, rptr)
    return 0
}

fn pe_push_sec_b(out: int, chars: int) -> int {
    __omni_bytes_push_u32(out, 0)
    __omni_bytes_push_u32(out, 0)
    __omni_bytes_push_u16(out, 0)
    __omni_bytes_push_u16(out, 0)
    __omni_bytes_push_u32(out, chars)
    return 0
}

fn thumb_patch_b32(buf: int, off: int, target: int, is_bl: int) -> int {
    let rel = target - (off + 4)
    let s = (rel >> 24) & 1
    let i1 = (rel >> 23) & 1
    let i2 = (rel >> 22) & 1
    let j1 = (i1 ^ 1) ^ s
    let j2 = (i2 ^ 1) ^ s
    let imm10 = (rel >> 12) & 0x3FF
    let imm11 = (rel >> 1) & 0x7FF
    let hw1 = 0xF000 | (s << 10) | imm10
    let base2 = 0x9000
    if is_bl == 1 {
        base2 = 0xD000
    }
    let hw2 = base2 | (j1 << 13) | (j2 << 11) | imm11
    let packed = (hw2 << 16) | hw1
    __omni_bytes_patch_u32(buf, off, packed)
    return 0
}

fn thumb_push_movw_r0(buf: int, imm16: int) -> int {
    let hw1 = 0xF240 | (((imm16 >> 11) & 1) << 10) | ((imm16 >> 12) & 0xF)
    let hw2 = (((imm16 >> 8) & 7) << 12) | (imm16 & 0xFF)
    __omni_bytes_push_u16(buf, hw1)
    __omni_bytes_push_u16(buf, hw2)
    return 0
}

fn thumb_push_movt_r0(buf: int, imm16: int) -> int {
    let hw1 = 0xF2C0 | (((imm16 >> 11) & 1) << 10) | ((imm16 >> 12) & 0xF)
    let hw2 = (((imm16 >> 8) & 7) << 12) | (imm16 & 0xFF)
    __omni_bytes_push_u16(buf, hw1)
    __omni_bytes_push_u16(buf, hw2)
    return 0
}

fn x64_add_rela(rela: int, off: int, sym_idx: int, rtype: int, addend: int) -> int {
    __omni_bytes_push_u64(rela, off)
    __omni_bytes_push_u32(rela, rtype)
    __omni_bytes_push_u32(rela, sym_idx)
    __omni_bytes_push_u64(rela, addend)
    return 0
}

fn elf64_push_sym(symtab: int, name_off: int, info: int, shndx: int, val: int, size: int) -> int {
    __omni_bytes_push_u32(symtab, name_off)
    __omni_bytes_push_u8(symtab, info)
    __omni_bytes_push_u8(symtab, 0)
    __omni_bytes_push_u16(symtab, shndx)
    __omni_bytes_push_u64(symtab, val)
    __omni_bytes_push_u64(symtab, size)
    return 0
}

fn elf64_push_shdr_a(out: int, name_off: int, stype: int, sflags: int, soff: int, ssize: int) -> int {
    __omni_bytes_push_u32(out, name_off)
    __omni_bytes_push_u32(out, stype)
    __omni_bytes_push_u64(out, sflags)
    __omni_bytes_push_u64(out, 0)
    __omni_bytes_push_u64(out, soff)
    __omni_bytes_push_u64(out, ssize)
    return 0
}

fn elf64_push_shdr_b(out: int, slink: int, sinfo: int, salign: int, sentsize: int) -> int {
    __omni_bytes_push_u32(out, slink)
    __omni_bytes_push_u32(out, sinfo)
    __omni_bytes_push_u64(out, salign)
    __omni_bytes_push_u64(out, sentsize)
    return 0
}

fn buf_append_buf(dst: int, src: int) -> int {
    let n = __omni_bytes_len(src)
    let i = 0
    while i < n {
        __omni_bytes_push_u8(dst, __omni_bytes_get(src, i))
        i = i + 1
    }
    return 0
}

fn buf_pad_align(buf: int, align: int) -> int {
    let rem = __omni_bytes_len(buf) % align
    if rem != 0 {
        let pad = align - rem
        while pad > 0 {
            __omni_bytes_push_u8(buf, 0)
            pad = pad - 1
        }
    }
    return 0
}

fn a64_ldr_slot(text: int, rt: int, slot: int) -> int {
    let imm12 = 2 + slot
    let w = 0xF94003A0 | (imm12 << 10) | rt
    __omni_bytes_push_u32(text, w)
    return 0
}

fn a64_str_slot(text: int, rt: int, slot: int) -> int {
    let imm12 = 2 + slot
    let w = 0xF90003A0 | (imm12 << 10) | rt
    __omni_bytes_push_u32(text, w)
    return 0
}

fn a64_movz_imm16(text: int, rd: int, imm16: int) -> int {
    let w = 0xD2800000 | ((imm16 & 0xFFFF) << 5) | rd
    __omni_bytes_push_u32(text, w)
    return 0
}

fn a64_movk_imm16(text: int, rd: int, imm16: int, shift_idx: int) -> int {
    let base = 0xF2A00000
    if shift_idx == 2 {
        base = 0xF2C00000
    }
    if shift_idx == 3 {
        base = 0xF2E00000
    }
    let w = base | ((imm16 & 0xFFFF) << 5) | rd
    __omni_bytes_push_u32(text, w)
    return 0
}

fn path_dirname(path: int) -> int {
    let n = __omni_str_len(path)
    let last_slash = -1
    let i = 0
    while i < n {
        if __omni_str_byte_at(path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return ""
    }
    return __omni_str_slice_step(path, 0, last_slash + 1, 1, 1, 1)
}

fn slice_has_str(sl: int, s: int) -> int {
    let n = __omni_slice_len(sl)
    let i = 0
    while i < n {
        if __omni_str_eq(__omni_slice_get(sl, i), s) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn load_source_with_imports(path: int, visited: int) -> int {
    if slice_has_str(visited, path) == 1 {
        return ""
    }
    __omni_slice_append(visited, path)
    let src = __omni_fs_read_text(path)
    let n = __omni_str_len(src)
    if n == 0 {
        return ""
    }
    let dir = path_dirname(path)
    let combined = ""
    let i = 0
    while i < n {
        let line_start = i
        while i < n && __omni_str_byte_at(src, i) != 10 {
            i = i + 1
        }
        let line_end = i
        if i < n {
            i = i + 1
        }
        let j = line_start
        while j < line_end && (__omni_str_byte_at(src, j) == 32 || __omni_str_byte_at(src, j) == 9) {
            j = j + 1
        }
        let imp_path = ""
        if j + 7 < line_end && __omni_str_byte_at(src, j) == 105 && __omni_str_byte_at(src, j + 1) == 109 && __omni_str_byte_at(src, j + 2) == 112 && __omni_str_byte_at(src, j + 3) == 111 && __omni_str_byte_at(src, j + 4) == 114 && __omni_str_byte_at(src, j + 5) == 116 && __omni_str_byte_at(src, j + 6) == 32 {
            let q = j + 7
            while q < line_end && __omni_str_byte_at(src, q) != 34 {
                q = q + 1
            }
            if q < line_end {
                let q1 = q + 1
                let q2 = q1
                while q2 < line_end && __omni_str_byte_at(src, q2) != 34 {
                    q2 = q2 + 1
                }
                if q2 > q1 {
                    let rel = __omni_str_slice_step(src, q1, q2, 1, 1, 1)
                    let cand1 = __omni_str_concat(dir, rel)
                    if __omni_fs_exists(cand1) == 1 {
                        imp_path = cand1
                    }
                    if __omni_str_len(imp_path) == 0 && __omni_fs_exists(__omni_str_concat(cand1, ".omni")) == 1 {
                        imp_path = __omni_str_concat(cand1, ".omni")
                    }
                    if __omni_str_len(imp_path) == 0 && __omni_fs_exists(__omni_str_concat(cand1, ".py")) == 1 {
                        imp_path = __omni_str_concat(cand1, ".py")
                    }
                    if __omni_str_len(imp_path) == 0 && __omni_fs_exists(__omni_str_concat(cand1, ".rs")) == 1 {
                        imp_path = __omni_str_concat(cand1, ".rs")
                    }
                    if __omni_str_len(imp_path) == 0 && __omni_fs_exists(__omni_str_concat(cand1, ".js")) == 1 {
                        imp_path = __omni_str_concat(cand1, ".js")
                    }
                }
            }
        }
        if __omni_str_len(imp_path) == 0 && j + 4 < line_end && __omni_str_byte_at(src, j) == 109 && __omni_str_byte_at(src, j + 1) == 111 && __omni_str_byte_at(src, j + 2) == 100 && __omni_str_byte_at(src, j + 3) == 32 {
            let m1 = j + 4
            let m2 = m1
            while m2 < line_end && is_alnum(__omni_str_byte_at(src, m2)) == 1 {
                m2 = m2 + 1
            }
            if m2 > m1 {
                let mname = __omni_str_slice_step(src, m1, m2, 1, 1, 1)
                let base = __omni_str_concat(dir, mname)
                let c_omni = __omni_str_concat(base, ".omni")
                if __omni_fs_exists(c_omni) == 1 {
                    imp_path = c_omni
                } else {
                    let c_rs = __omni_str_concat(base, ".rs")
                    if __omni_fs_exists(c_rs) == 1 {
                        imp_path = c_rs
                    }
                }
            }
        }
        if __omni_str_len(imp_path) > 0 {
            let sub = load_source_with_imports(imp_path, visited)
            if __omni_str_len(sub) > 0 {
                combined = __omni_str_concat(combined, sub)
                combined = __omni_str_concat(combined, "\n")
            }
        }
    }
    combined = __omni_str_concat(combined, src)
    return combined
}

fn canonicalize_indents(src: int) -> int {
    let n = __omni_str_len(src)
    let has_indent_blk = 0
    let ci = 0
    while ci < n {
        let ls = ci
        while ci < n && __omni_str_byte_at(src, ci) != 10 {
            ci = ci + 1
        }
        let le = ci
        if ci < n {
            ci = ci + 1
        }
        let s = ls
        while s < le && (__omni_str_byte_at(src, s) == 32 || __omni_str_byte_at(src, s) == 9) {
            s = s + 1
        }
        let t = le - 1
        while t >= s && (__omni_str_byte_at(src, t) == 32 || __omni_str_byte_at(src, t) == 9 || __omni_str_byte_at(src, t) == 13) {
            t = t - 1
        }
        if t >= s && __omni_str_byte_at(src, t) == 58 {
            let b0 = __omni_str_byte_at(src, s)
            if s + 3 <= t && b0 == 100 && __omni_str_byte_at(src, s + 1) == 101 && __omni_str_byte_at(src, s + 2) == 102 && __omni_str_byte_at(src, s + 3) == 32 {
                has_indent_blk = 1
            }
            if s + 2 <= t && b0 == 105 && __omni_str_byte_at(src, s + 1) == 102 && __omni_str_byte_at(src, s + 2) == 32 {
                has_indent_blk = 1
            }
            if s + 5 <= t && b0 == 119 && __omni_str_byte_at(src, s + 1) == 104 && __omni_str_byte_at(src, s + 2) == 105 && __omni_str_byte_at(src, s + 3) == 108 && __omni_str_byte_at(src, s + 4) == 101 && __omni_str_byte_at(src, s + 5) == 32 {
                has_indent_blk = 1
            }
            if s + 3 <= t && b0 == 102 && __omni_str_byte_at(src, s + 1) == 111 && __omni_str_byte_at(src, s + 2) == 114 && __omni_str_byte_at(src, s + 3) == 32 {
                has_indent_blk = 1
            }
            if s + 5 <= t && b0 == 99 && __omni_str_byte_at(src, s + 1) == 108 && __omni_str_byte_at(src, s + 2) == 97 && __omni_str_byte_at(src, s + 3) == 115 && __omni_str_byte_at(src, s + 4) == 115 && __omni_str_byte_at(src, s + 5) == 32 {
                has_indent_blk = 1
            }
        }
    }
    if has_indent_blk == 0 {
        return src
    }
    let out = ""
    let stack = __omni_slice_create(64)
    let st_depth = 0
    let i = 0
    while i < n {
        let ls = i
        while i < n && __omni_str_byte_at(src, i) != 10 {
            i = i + 1
        }
        let le = i
        if i < n {
            i = i + 1
        }
        let ind = 0
        let j = ls
        while j < le && (__omni_str_byte_at(src, j) == 32 || __omni_str_byte_at(src, j) == 9) {
            if __omni_str_byte_at(src, j) == 9 {
                ind = ind + 4
            } else {
                ind = ind + 1
            }
            j = j + 1
        }
        let te = le - 1
        while te >= j && (__omni_str_byte_at(src, te) == 32 || __omni_str_byte_at(src, te) == 9 || __omni_str_byte_at(src, te) == 13) {
            te = te - 1
        }
        let is_attr = 0
