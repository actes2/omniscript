                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 33)
                        __omni_bytes_push_u8(text, 200)
                        x64_store_rax(text, dst)
                    }
                    if tag == 20 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 9)
                        __omni_bytes_push_u8(text, 200)
                        x64_store_rax(text, dst)
                    }
                    if tag == 21 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 49)
                        __omni_bytes_push_u8(text, 200)
                        x64_store_rax(text, dst)
                    }
                    if tag == 22 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 211)
                        __omni_bytes_push_u8(text, 224)
                        x64_store_rax(text, dst)
                    }
                    if tag == 23 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 211)
                        __omni_bytes_push_u8(text, 248)
                        x64_store_rax(text, dst)
                    }
                    if tag == 24 {
                        __omni_bytes_push_u8(text, 72)
                        __omni_bytes_push_u8(text, 211)
                        __omni_bytes_push_u8(text, 232)
                        x64_store_rax(text, dst)
                    }
                }
                if tag >= 29 && tag <= 32 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let a = x64_read_u16(ops_buf, cur + 2)
                    let b = x64_read_u16(ops_buf, cur + 4)
                    cur = cur + 6
                    __omni_bytes_push_u8(text, 242)
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, 16)
                    __omni_bytes_push_u8(text, 133)
                    __omni_bytes_push_u32(text, x64_slot_disp(a))
                    let sse_op = 88
                    if tag == 30 {
                        sse_op = 92
                    }
                    if tag == 31 {
                        sse_op = 89
                    }
                    if tag == 32 {
                        sse_op = 94
                    }
                    __omni_bytes_push_u8(text, 242)
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, sse_op)
                    __omni_bytes_push_u8(text, 133)
                    __omni_bytes_push_u32(text, x64_slot_disp(b))
                    __omni_bytes_push_u8(text, 242)
                    __omni_bytes_push_u8(text, 15)
                    __omni_bytes_push_u8(text, 17)
                    __omni_bytes_push_u8(text, 133)
                    __omni_bytes_push_u32(text, x64_slot_disp(dst))
                }
                if tag == 39 {
                    let dst = x64_read_u16(ops_buf, cur)
                    let cc = __omni_bytes_get(ops_buf, cur + 2)
                    let a = x64_read_u16(ops_buf, cur + 3)
                    let b = x64_read_u16(ops_buf, cur + 5)
                    cur = cur + 7
                    let op_l = a
                    let op_r = b
                    if cc == 2 || cc == 3 {
