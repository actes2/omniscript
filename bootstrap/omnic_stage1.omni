    fn parse_cmp(self) -> int {
        let lhs = self.parse_bitor()
        let lhs_f = self.last_expr_is_float
        let k = self.peek_kind()
        if k >= 31 && k <= 36 {
            self.advance()
            let rhs = self.parse_bitor()
            let is_f = 0
            if lhs_f == 1 || self.last_expr_is_float == 1 {
                is_f = 1
            }
            let dst = self.alloc_reg()
            let cc = 0
            if k == 31 {
                cc = 0
            }
            if k == 32 {
                cc = 1
            }
            if k == 33 {
                cc = 2
            }
            if k == 34 {
                cc = 3
            }
            if k == 35 {
                cc = 4
            }
            if k == 36 {
                cc = 5
            }
            if is_f == 1 {
                lhs = self.emit_fcmp(cc, dst, lhs, rhs)
            } else {
                lhs = self.emit_icmp(cc, dst, lhs, rhs)
            }
            self.clear_expr_types()
        }
        return lhs
    }

    fn parse_and(self) -> int {
        let lhs = self.parse_cmp()
        while self.peek_kind() == 37 {
            self.advance()
            let res = self.alloc_reg()
            self.emit_load_imm(res, 0)
            let br_patch = self.emit_brif(lhs, 0, 0)
            let rhs_pc = self.cur_op_count
            __omni_bytes_patch_u32(self.cur_ops, br_patch, rhs_pc)
            let rhs = self.parse_cmp()
            let zero = self.alloc_reg()
            self.emit_load_imm(zero, 0)
            self.emit_icmp(1, res, rhs, zero)
            let done_pc = self.cur_op_count
            __omni_bytes_patch_u32(self.cur_ops, br_patch + 4, done_pc)
            lhs = res
            self.clear_expr_types()
        }
        return lhs
    }

    fn parse_or(self) -> int {
        let lhs = self.parse_and()
        while self.peek_kind() == 38 {
            self.advance()
            let res = self.alloc_reg()
            self.emit_load_imm(res, 1)
            let br_patch = self.emit_brif(lhs, 0, 0)
            let rhs_pc = self.cur_op_count
            __omni_bytes_patch_u32(self.cur_ops, br_patch + 4, rhs_pc)
            let rhs = self.parse_and()
            let zero = self.alloc_reg()
            self.emit_load_imm(zero, 0)
            self.emit_icmp(1, res, rhs, zero)
            let done_pc = self.cur_op_count
            __omni_bytes_patch_u32(self.cur_ops, br_patch, done_pc)
            lhs = res
            self.clear_expr_types()
        }
        return lhs
    }

    fn parse_expr(self) -> int {
        return self.parse_or()
    }

    fn parse_block(self) -> int {
        if self.peek_kind() == 12 {
            self.advance()
        }
        while self.peek_kind() != 13 && self.peek_kind() != 0 {
            self.parse_stmt()
        }
        if self.peek_kind() == 13 {
            self.advance()
        }
