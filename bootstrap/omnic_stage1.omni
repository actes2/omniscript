                        __omni_bytes_push_u8(text, 148)
                        __omni_bytes_push_u8(text, 192)
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 155)
                        __omni_bytes_push_u8(text, 193)
                        __omni_bytes_push_u8(text, 32)
                        __omni_bytes_push_u8(text, 200)
                    }
                    if cc == 1 {
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 149)
                        __omni_bytes_push_u8(text, 192)
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 154)
                        __omni_bytes_push_u8(text, 193)
                        __omni_bytes_push_u8(text, 8)
                        __omni_bytes_push_u8(text, 200)
                    }
                    if cc == 2 || cc == 4 {
                        __omni_bytes_push_u8(text, 15)
                        __omni_bytes_push_u8(text, 151)
                        __omni_bytes_push_u8(text, 192)
