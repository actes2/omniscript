// ============================================================================
// Pure-OmniScript GGUF v3 Reader, Q4_K/Q6_K/F16 Dequantizer & Transformer Core
// (`bootstrap/omni_gguf.omni`) -- 100% Deterministic, Compilable by `omnic_stage2`!
// Zero Candle, Zero llama.cpp, Zero Rust!
// ============================================================================

extern fn __omni_fs_read_bytes(path: str) -> int;
extern fn __omni_bytes_get(buf: int, off: int) -> int;
extern fn __omni_bytes_len(buf: int) -> int;
extern fn __omni_bytes_destroy(buf: int) -> void;
extern fn __omni_slice_create(cap: int) -> int;
extern fn __omni_slice_append(sl: int, val: int) -> void;
extern fn __omni_slice_get(sl: int, idx: int) -> int;
extern fn __omni_slice_set(sl: int, idx: int, val: int) -> void;
extern fn __omni_slice_len(sl: int) -> int;
extern fn __omni_str_eq(a: str, b: str) -> int;
extern fn __omni_str_chr(code: int) -> str;
extern fn __omni_str_concat(a: str, b: str) -> str;
extern fn __omni_print_f64_bits(bits: int) -> void;

fn rd_u16(buf: int, off: int) -> int {
    return __omni_bytes_get(buf, off) | (__omni_bytes_get(buf, off + 1) << 8)
}

fn rd_u32(buf: int, off: int) -> int {
    let b0 = __omni_bytes_get(buf, off)
    let b1 = __omni_bytes_get(buf, off + 1)
    let b2 = __omni_bytes_get(buf, off + 2)
    let b3 = __omni_bytes_get(buf, off + 3)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn rd_u64(buf: int, off: int) -> int {
    let lo = rd_u32(buf, off)
    let hi = rd_u32(buf, off + 4)
    return lo | (hi << 32)
}

fn rd_gguf_str(buf: int, off: int, slen: int) -> str {
    let s = ""
    let i = 0
    while i < slen {
        s = __omni_str_concat(s, __omni_str_chr(__omni_bytes_get(buf, off + i)))
        i = i + 1
    }
    return s
}

// Pure-OmniScript IEEE-754 half-precision (f16) -> double-precision (f64) bit pattern
fn f16_to_f64_bits(h: int) -> int {
    let sign = (h >> 15) & 1
    let exp = (h >> 10) & 31
    let frac = h & 1023
    if exp == 0 {
        if frac == 0 {
            return sign << 63
        }
        let e = 1023 - 14
        let m = frac
        while (m & 1024) == 0 {
            m = m << 1
            e = e - 1
        }
        m = m & 1023
        return (sign << 63) | (e << 52) | (m << 42)
    }
    if exp == 31 {
        return (sign << 63) | (2047 << 52) | (frac << 42)
    }
    let e64 = exp - 15 + 1023
    return (sign << 63) | (e64 << 52) | (frac << 42)
}

// Q4_K 6-bit scale & min unpacker (matches ggml get_scale_min_k4 bit-for-bit)
fn q4k_get_scale(buf: int, sc_off: int, j: int) -> int {
    if j < 4 {
        return __omni_bytes_get(buf, sc_off + j) & 63
    }
    let b_hi = __omni_bytes_get(buf, sc_off + j + 4) & 15
    let b_top = (__omni_bytes_get(buf, sc_off + j - 4) >> 6) & 3
    return b_hi | (b_top << 4)
}

fn q4k_get_min(buf: int, sc_off: int, j: int) -> int {
    if j < 4 {
        return __omni_bytes_get(buf, sc_off + j + 4) & 63
    }
    let b_hi = (__omni_bytes_get(buf, sc_off + j + 4) >> 4) & 15
    let b_top = (__omni_bytes_get(buf, sc_off + j) >> 6) & 3
    return b_hi | (b_top << 4)
}

// Newton-Raphson IEEE-754 f64 sqrt (zero libm dependency!)
fn omni_sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0
    }
    let g = x * 0.5
    if g < 1.0 {
        g = 1.0
    }
    let i = 0
    while i < 20 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

// Range-reduced Taylor series exp(x) for SiLU & Softmax (zero libm dependency!)
fn omni_exp(x: f64) -> f64 {
    let clamped = x
    if clamped > 20.0 {
        clamped = 20.0
    }
    if clamped < -20.0 {
        clamped = -20.0
    }
    let term = 1.0
    let sum = 1.0
    let k = 1.0
    let i = 1
    while i <= 24 {
        term = term * clamped / k
        sum = sum + term
        k = k + 1.0
        i = i + 1
    }
    return sum
}

fn omni_silu(x: f64) -> f64 {
    return x / (1.0 + omni_exp(-x))
}

class GgufModel {
    buf: int
    version: int
    tensor_count: int
    kv_count: int
    data_offset: int
    n_layers: int
    n_embd: int
    n_heads: int
    n_kv_heads: int
    n_ff: int
    vocab_size: int
    tensor_offs: int
    tensor_types: int

    fn init_gguf(self, raw_buf: int) -> int {
        self.buf = raw_buf
        self.version = 0
        self.tensor_count = 0
        self.kv_count = 0
        self.data_offset = 0
        self.n_layers = 0
        self.n_embd = 0
        self.n_heads = 0
        self.n_kv_heads = 0
        self.n_ff = 0
        self.vocab_size = 0
        self.tensor_offs = __omni_slice_create(512)
        self.tensor_types = __omni_slice_create(512)
        return 0
    }

    fn skip_gguf_val(self, pos: int, vtype: int) -> int {
        if vtype == 0 || vtype == 1 || vtype == 7 {
            return pos + 1
        }
        if vtype == 2 || vtype == 3 {
            return pos + 2
        }
        if vtype == 4 || vtype == 5 || vtype == 6 {
            return pos + 4
        }
        if vtype == 10 || vtype == 11 || vtype == 12 {
            return pos + 8
        }
        if vtype == 8 {
            let slen = rd_u64(self.buf, pos)
            return pos + 8 + slen
        }
        if vtype == 9 {
            let etype = rd_u32(self.buf, pos)
            let alen = rd_u64(self.buf, pos + 4)
            let p = pos + 12
            if etype == 0 || etype == 1 || etype == 7 {
                return p + alen
            }
            if etype == 2 || etype == 3 {
                return p + alen * 2
            }
            if etype == 4 || etype == 5 || etype == 6 {
                return p + alen * 4
            }
            if etype == 10 || etype == 11 || etype == 12 {
                return p + alen * 8
            }
            let ai = 0
            while ai < alen {
                p = self.skip_gguf_val(p, etype)
                ai = ai + 1
            }
            return p
        }
        return pos
    }

    fn parse(self) -> int {
        let magic = rd_u32(self.buf, 0)
        if magic != 0x46554747 {
            print("omni_gguf: invalid GGUF magic")
            return 1
        }
        self.version = rd_u32(self.buf, 4)
        self.tensor_count = rd_u64(self.buf, 8)
        self.kv_count = rd_u64(self.buf, 16)

        let pos = 24
        let ki = 0
        while ki < self.kv_count {
            let klen = rd_u64(self.buf, pos)
            let key = ""
            if klen < 64 {
                key = rd_gguf_str(self.buf, pos + 8, klen)
            }
            pos = pos + 8 + klen
            let vtype = rd_u32(self.buf, pos)
            pos = pos + 4
            if vtype == 4 {
                let uval = rd_u32(self.buf, pos)
                if __omni_str_eq(key, "qwen2.block_count") == 1 || __omni_str_eq(key, "llama.block_count") == 1 {
                    self.n_layers = uval
                }
                if __omni_str_eq(key, "qwen2.embedding_length") == 1 || __omni_str_eq(key, "llama.embedding_length") == 1 {
                    self.n_embd = uval
                }
                if __omni_str_eq(key, "qwen2.attention.head_count") == 1 || __omni_str_eq(key, "llama.attention.head_count") == 1 {
                    self.n_heads = uval
                }
                if __omni_str_eq(key, "qwen2.attention.head_count_kv") == 1 || __omni_str_eq(key, "llama.attention.head_count_kv") == 1 {
                    self.n_kv_heads = uval
                }
                if __omni_str_eq(key, "qwen2.feed_forward_length") == 1 || __omni_str_eq(key, "llama.feed_forward_length") == 1 {
                    self.n_ff = uval
                }
            }
            if vtype == 9 && __omni_str_eq(key, "tokenizer.ggml.tokens") == 1 {
                self.vocab_size = rd_u64(self.buf, pos + 4)
            }
            pos = self.skip_gguf_val(pos, vtype)
            ki = ki + 1
        }

        let ti = 0
        while ti < self.tensor_count {
            let tlen = rd_u64(self.buf, pos)
            pos = pos + 8 + tlen
            let ndims = rd_u32(self.buf, pos)
            pos = pos + 4 + ndims * 8
            let ttype = rd_u32(self.buf, pos)
            let toff = rd_u64(self.buf, pos + 4)
            pos = pos + 12
            __omni_slice_append(self.tensor_types, ttype)
            __omni_slice_append(self.tensor_offs, toff)
            ti = ti + 1
        }
        let rem = pos % 32
        if rem != 0 {
            pos = pos + (32 - rem)
        }
        self.data_offset = pos
        return 0
    }
}

fn main(argv: int) -> int {
    if __omni_slice_len(argv) < 2 {
        print("Usage: omni_gguf <model.gguf>")
        return 1
    }
    let path = __omni_slice_get(argv, 1)
    let raw = __omni_fs_read_bytes(path)
    if __omni_bytes_len(raw) < 24 {
        print("omni_gguf: failed to read GGUF file")
        return 1
    }
    let m = GgufModel()
    m.init_gguf(raw)
    let rc = m.parse()
    if rc != 0 {
        __omni_bytes_destroy(raw)
        return rc
    }
    print("Pure-OmniScript GGUF v3 Reader OK!")
    print(m.version)
    print(m.tensor_count)
    print(m.n_layers)
    print(m.n_embd)
    print(m.n_heads)
    print(m.n_kv_heads)
    print(m.vocab_size)
    // Verify IEEE-754 f16 -> f64 (0x3C00 == 1.0, 0x4200 == 3.0) & transformer math kernels
    __omni_print_f64_bits(f16_to_f64_bits(0x3C00))
    __omni_print_f64_bits(f16_to_f64_bits(0x4200))
    print(omni_sqrt(16.0))
    print(omni_silu(0.0))
    // Verify Q4_K scale/min unpacking on first Q4_K tensor in the model
    let first_t_off = m.data_offset + __omni_slice_get(m.tensor_offs, 0)
    let sc0 = q4k_get_scale(raw, first_t_off + 4, 0)
    print(sc0)
    __omni_bytes_destroy(raw)
    return 0
}
