{
  "Main Function": {
    "prefix": "main",
    "body": [
      "fn main() -> int {",
      "    $0",
      "    return 0;",
      "}"
    ],
    "description": "OmniScript main entrypoint"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:arg}: ${3:int}) -> ${4:int} {",
      "    $0",
      "}"
    ],
    "description": "OmniScript function definition"
  },
  "Extern C Block": {
    "prefix": "extern",
    "body": [
      "extern \"C\" {",
      "    fn ${1:sym}(${2:x}: ${3:int}) -> ${4:int};",
      "}"
    ],
    "description": "First-class extern C FFI block"
  },
  "Pico 2 W Firmware Skeleton": {
    "prefix": "pico2w",
    "body": [
      "import \"pico2w\";",
      "",
      "fn main() -> int {",
      "    cyw43_led_init();",
      "    let state = 1;",
      "    while 1 {",
      "        cyw43_led_put(state);",
      "        sleep_ms(${1:250});",
      "        state = 1 - state;",
      "    }",
      "    return 0;",
      "}"
    ],
    "description": "Bare-metal Raspberry Pi Pico 2 W blink skeleton"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:int},",
      "}"
    ],
    "description": "OmniScript struct definition"
  }
}
